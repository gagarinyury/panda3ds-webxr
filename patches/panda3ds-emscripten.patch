diff --git a/src/core/CPU/cpu_dynarmic.cpp b/src/core/CPU/cpu_dynarmic.cpp
index 124647d..a317f28 100644
--- a/src/core/CPU/cpu_dynarmic.cpp
+++ b/src/core/CPU/cpu_dynarmic.cpp
@@ -22,6 +22,12 @@ CPU::CPU(Memory& mem, Kernel& kernel, Emulator& emu) : mem(mem), emu(emu), sched
 		config.fastmem_pointer = std::nullopt;
 	}
 
+#ifdef __EMSCRIPTEN__
+	// WebAssembly JIT: let generated code index the guest page tables directly
+	config.wasm_read_table = reinterpret_cast<const u32*>(mem.getReadTableBase());
+	config.wasm_write_table = reinterpret_cast<const u32*>(mem.getWriteTableBase());
+#endif
+
 	jit = std::make_unique<Dynarmic::A32::Jit>(config);
 }
 
