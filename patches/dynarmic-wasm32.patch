+                    const u32 ovl = Tmp(I32);
+                    c.I32Const(0);
+                    c.LocalSet(ovl);
+                    Alias(ov, ovl);
+                }
+                return;
+            }
+            const u32 max_val = (1u << (N - 1)) - 1;
+            const s32 min_val = static_cast<s32>(~u32{0} << (N - 1));
+
+            c.I32Const(static_cast<s32>(max_val));
+            c.I32Const(min_val);
+            c.LocalGet(vl);
+            c.LocalGet(vl);
+            c.I32Const(min_val);
+            c.I32LtS();
+            c.Select();
+            c.LocalGet(vl);
+            c.I32Const(static_cast<s32>(max_val));
+            c.I32GtS();
+            c.Select();
+            const u32 res = Tmp(I32);
+            c.LocalSet(res);
+            Alias(inst, res);
