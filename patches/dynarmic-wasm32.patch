+                PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); CallHelper("fsqrt32"); Set(inst);
+                return;
+            }
+            const bool is64 = op == Opcode::FPAdd64 || op == Opcode::FPSub64 || op == Opcode::FPMul64 || op == Opcode::FPDiv64;
