+                c.LocalSet(ovl);
+                Alias(ov, ovl);
+            }
+            return;
+        }
+        case Opcode::UnsignedSaturation: {
+            const size_t N = inst->GetArg(1).GetU8();
+            const u32 saturated_value = (1u << N) - 1;
+            const u32 vl = Tmp(I32);
+            Ld(inst->GetArg(0));
+            c.LocalSet(vl);
+
+            c.I32Const(0);
+            c.I32Const(static_cast<s32>(saturated_value));
+            c.LocalGet(vl);
+            c.LocalGet(vl);
+            c.I32Const(static_cast<s32>(saturated_value));
+            c.I32GtS();
+            c.Select();
+            c.LocalGet(vl);
+            c.I32Const(0);
+            c.I32LtS();
+            c.Select();
+            const u32 res = Tmp(I32);
+            c.LocalSet(res);
+            Alias(inst, res);
