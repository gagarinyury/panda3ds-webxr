+    void EmitInst(IR::Inst* inst) {
+        const Opcode op = inst->GetOpcode();
+        switch (op) {
+        // ----- pseudo operations: produced together with their parent instruction -----
+        case Opcode::GetNZFromOp: {
+            const IR::Value src = inst->GetArg(0);
