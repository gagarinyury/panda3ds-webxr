index 0000000..6efb1aa
--- /dev/null
+++ b/src/dynarmic/backend/wasm/emit_a32.h
@@ -0,0 +1,68 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include <mcl/stdint.hpp>
+
+#include "dynarmic/interface/A32/config.h"
+#include "dynarmic/ir/basic_block.h"
+
+namespace Dynarmic::Backend::Wasm {
+
+// Host functions that generated blocks may import (module "e"). Signature: params '>' result;
+// i = i32, l = i64, v = none. The first parameter of every helper is the Jit::Impl* context.
+struct HelperDef {
+    const char* name;
+    const char* sig;
+};
+
+inline constexpr HelperDef kHelpers[] = {
+    {"r8", "ii>i"},   {"r16", "ii>i"},  {"r32", "ii>i"},  {"r64", "ii>l"},
+    {"w8", "iii>v"},  {"w16", "iii>v"}, {"w32", "iii>v"}, {"w64", "iil>v"},
+    {"xr8", "ii>i"},  {"xr16", "ii>i"}, {"xr32", "ii>i"}, {"xr64", "ii>l"},
+    {"xw8", "iii>i"}, {"xw16", "iii>i"}, {"xw32", "iii>i"}, {"xw64", "iil>i"},
+    {"clrex", "i>v"},
+    {"svc", "ii>v"},  {"exc", "iii>v"}, {"interp", "iii>v"}, {"isb", "i>v"},
+    {"getcpsr", "i>i"}, {"setcpsr", "ii>v"}, {"getfpscr", "i>i"}, {"setfpscr", "ii>v"},
+    {"cpget1", "iiiii>i"},  // ctx, callback fn, user_arg, arg0, arg1 -> u32
+    {"cpcall", "iiiii>v"},  // ctx, callback fn, user_arg, arg0, arg1 (result ignored)
+    // VFP scalar arithmetic: (ctx, fpcr, a, b) -> result; FPSR cumulative flags are updated in the state
+    {"fadd32", "iiii>i"}, {"fsub32", "iiii>i"}, {"fmul32", "iiii>i"}, {"fdiv32", "iiii>i"}, {"fsqrt32", "iii>i"},
+    {"fadd64", "iill>l"}, {"fsub64", "iill>l"}, {"fmul64", "iill>l"}, {"fdiv64", "iill>l"}, {"fsqrt64", "iil>l"},
+    {"fcmp32", "iiiii>i"}, {"fcmp64", "iilli>i"},
+    {"pk", "iii>i"},   // packed halving / saturating ops: (kind, a, b) -> result, see H_pk
+    {"fs2d", "iiii>l"}, {"fd2s", "iili>i"},
+    {"ftoi", "iili>i"},   // (ctx, fpcr, value as i64, mode) -> int bits
+    {"itof", "iiii>l"},   // (ctx, fpcr, int bits, mode) -> float bits (zero-extended)
+};
+
+struct EmitResult {
+    std::vector<u8> bytes;
+    std::string error;  // empty on success
+    bool ok() const { return error.empty(); }
+};
+
+// Block chaining: blocks end by tail-calling the next block through a shared function table, found via a direct-mapped
+// cache of {pc, upper location bits, table slot} entries that lives in linear memory.
+struct EmitOptions {
+    u32 link_base = 0;      ///< address of the link cache (array of LinkEntry)
+    u32 link_mask = 0;      ///< number of entries - 1 (power of two minus one)
+    bool chain = false;
+    bool chain_tail = false;  ///< true: wasm tail calls (return_call_indirect); false: nested call_indirect with a depth limit
+    u32 chain_depth_limit = 160;
+    u32 fast_fp_mask = 0x3f;   ///< which inline VFP ops are enabled (bit per kind: add, sub, mul, div, sqrt, cmp) - for bisecting engine problems
+    bool fast_fp = false;   ///< inline VFP for round-to-nearest / round-to-zero modes (exception flags are not accumulated on this path)
+};
+struct LinkEntry {
+    u32 pc, upper, slot, pad;
+};
+
+// Translates one IR block to a WebAssembly module exporting `b(state: i32) -> i32`
+// (0 = continue with PC from state, 1 = stop/return to the caller).
+EmitResult EmitA32Block(IR::Block& block, const A32::UserConfig& conf, const EmitOptions& opt = {});
+
+}  // namespace Dynarmic::Backend::Wasm
