+    void EmitPackedMixed16(IR::Inst* inst, bool add_top, bool signed_ge) {
+        const u32 al = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(al);
+        const u32 bl = Tmp(I32); Ld(inst->GetArg(1));
+        c.I32Const(16); c.I32Rotr(); c.LocalSet(bl);
+
+        const u32 sum = Tmp(I32);
+        c.LocalGet(al); c.I32Const(0x7fff7fff); c.I32And();
+        c.LocalGet(bl); c.I32Const(0x7fff7fff); c.I32And();
+        c.I32Add();
+        c.LocalGet(al); c.LocalGet(bl); c.I32Xor();
+        c.I32Const(static_cast<s32>(0x80008000u)); c.I32And();
+        c.I32Xor();
+        c.LocalSet(sum);
+
+        const u32 diff = Tmp(I32);
+        c.LocalGet(al); c.I32Const(static_cast<s32>(0x80008000u)); c.I32Or();
+        c.LocalGet(bl); c.I32Const(0x7fff7fff); c.I32And();
+        c.I32Sub();
+        c.LocalGet(al); c.LocalGet(bl); c.I32Const(-1); c.I32Xor(); c.I32Xor();
+        c.I32Const(static_cast<s32>(0x80008000u)); c.I32And();
+        c.I32Xor();
+        c.LocalSet(diff);
+
+        const u32 top_val = add_top ? sum : diff;
+        const u32 bot_val = add_top ? diff : sum;
+        c.LocalGet(top_val); c.I32Const(static_cast<s32>(0xffff0000u)); c.I32And();
+        c.LocalGet(bot_val); c.I32Const(0x0000ffff); c.I32And();
