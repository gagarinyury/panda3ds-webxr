@@ -0,0 +1,444 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * A32 Jit for WebAssembly: guest basic blocks are translated by Dynarmic's front end to IR, the IR is emitted as a small
+ * WASM module (emit_a32.cpp), and the module is instantiated through the JavaScript WebAssembly API so that the host
+ * engine (e.g. WebKit inside WKWebView) JIT-compiles it. Everything here runs inside an Emscripten module.
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <emscripten.h>
+
+#include "dynarmic/backend/wasm/a32_jitstate.h"
+#include "dynarmic/backend/wasm/emit_a32.h"
+#include "dynarmic/backend/wasm/fp_soft.h"
+#include "dynarmic/frontend/A32/a32_location_descriptor.h"
+#include "dynarmic/frontend/A32/translate/a32_translate.h"
+#include "dynarmic/interface/A32/a32.h"
+#include "dynarmic/interface/A32/config.h"
+#include "dynarmic/interface/exclusive_monitor.h"
+#include "dynarmic/ir/basic_block.h"
+#include "dynarmic/ir/opt/passes.h"
+
+// ---------- JavaScript side ----------
+EM_JS_DEPS(dynarmic_wasm_deps, "$UTF8ToString,$getWasmTableEntry");
+
+EM_JS(void, jit_js_register_helper, (const char* name, int fn), {
+    if (!Module.jit) Module.jit = { impls: [], helpers: {} };
+    Module.jit.helpers[UTF8ToString(name)] = getWasmTableEntry(fn);
+});
+
+EM_JS(int, jit_js_new_impl, (), {
+    if (!Module.jit) Module.jit = { impls: [], helpers: {} };
+    Module.jit.impls.push({ table: new WebAssembly.Table({ element: 'anyfunc', initial: 256 }) });
+    return Module.jit.impls.length - 1;
+});
+
+// Compiles a block module and installs it in the Impl's function table at `slot`.
+EM_JS(int, jit_js_compile, (int id, int slot, const uint8_t* p, int n), {
+    try {
+        const impl = Module.jit.impls[id];
+        const tA = performance.now();
+        const mod = new WebAssembly.Module(HEAPU8.slice(p, p + n));
+        const tB = performance.now();
+        const imports = { e: { m: wasmMemory, t: impl.table } };
+        for (const imp of WebAssembly.Module.imports(mod)) {
+            if (imp.kind === 'function') {
+                const f = Module.jit.helpers[imp.name];
+                if (!f) throw new Error('missing helper ' + imp.name);
+                imports.e[imp.name] = f;
+            }
+        }
+        const inst = new WebAssembly.Instance(mod, imports);
+        const tC = performance.now();
+        const T = Module.jit.t || (Module.jit.t = [0, 0, 0, 0]); T[1] += tB - tA; T[2] += tC - tB;   // [0] translate+optimize+emit (C++), [1] WebAssembly.Module, [2] WebAssembly.Instance + table
+        while (slot >= impl.table.length) impl.table.grow(impl.table.length);
+        impl.table.set(slot, inst.exports.b);
+        if (!impl.fnCache) impl.fnCache = [];
+        impl.fnCache[slot] = inst.exports.b;
+        impl.count = (impl.count || 0) + 1; impl.bytes = (impl.bytes || 0) + n;
+        return slot;
+    } catch (e) {
+        console.error('[jit] module failed:', e && e.message ? e.message : e);
+        return -1;
+    }
+});
+
+EM_JS(int, jit_js_run, (int id, int slot, int state), {
+    const impl = Module.jit.impls[id];
+    const fn = (impl.fnCache && impl.fnCache[slot]) || impl.table.get(slot);
+    return fn(state);
+});
+
+// Drops all compiled blocks: a fresh table (old blocks keep a reference to the old one but are never entered again).
+EM_JS(void, jit_js_clear, (int id, int dropped), {
+    const impl = Module.jit.impls[id];
+    impl.table = new WebAssembly.Table({ element: 'anyfunc', initial: 256 });
+    impl.fnCache = [];
+    if (!impl.flushes || impl.flushes < 3) { try { Module.printErr('[jit] cache flush #' + ((impl.flushes || 0) + 1) + ' dropping ' + dropped + ' blocks, called from: ' + (new Error().stack || '').split('\n').slice(1, 9).map((l) => { l = l.trim(); const k = l.indexOf(' ('); return k > 0 ? l.slice(3, k) : l; }).join(' < ')); } catch (e) {} }
+    impl.flushes = (impl.flushes || 0) + 1; impl.droppedBlocks = (impl.droppedBlocks || 0) + dropped;   // diagnostics: how often the whole cache is thrown away, and how many blocks that wasted
+});
+
+// Time accounting for the panel: kind 0 = translate + optimize + emit (C++ side), see jit_js_compile for the other two.
+EM_JS(void, jit_js_time, (int kind, double ms), { const T = Module.jit.t || (Module.jit.t = [0, 0, 0, 0]); T[kind] += ms; });
+EM_JS(double, jit_now_ms, (), { return performance.now(); });
+// Dispatch statistics for the panel/probes: S[0] = jit_js_run calls (returns to the C++ dispatcher), S[1] = guest ticks executed, S[2] = Jit::Run() calls.
+EM_JS(void, jit_js_stat, (int d, double t), { const S = Module.jit.s || (Module.jit.s = [0, 0, 0]); S[0] += d; S[1] += t; S[2]++; });
+
+// Breadcrumb for hang diagnosis: the message reaches the native app even if the page then spins forever.
+EM_JS(void, jit_js_crumb, (int kind, int pc, int x), {
+    const n = typeof window !== 'undefined' && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.panda;
+    if (n) n.postMessage(JSON.stringify({ type: 'crumb', k: kind, pc: pc >>> 0, x: x >>> 0 }));
+});
+
+namespace Dynarmic::A32 {
+
+struct Jit::Impl {
+    explicit Impl(UserConfig c) : conf(std::move(c)) {
+        static bool registered = false;
+        if (!registered) {
+            registered = true;
+#define REG(n, f) jit_js_register_helper(n, static_cast<int>(reinterpret_cast<uintptr_t>(&f)))
+            REG("r8", H_r8); REG("r16", H_r16); REG("r32", H_r32); REG("r64", H_r64);
+            REG("w8", H_w8); REG("w16", H_w16); REG("w32", H_w32); REG("w64", H_w64);
+            REG("xr8", H_xr8); REG("xr16", H_xr16); REG("xr32", H_xr32); REG("xr64", H_xr64);
+            REG("xw8", H_xw8); REG("xw16", H_xw16); REG("xw32", H_xw32); REG("xw64", H_xw64);
+            REG("clrex", H_clrex); REG("svc", H_svc); REG("exc", H_exc); REG("interp", H_interp); REG("isb", H_isb);
+            REG("getcpsr", H_getcpsr); REG("setcpsr", H_setcpsr); REG("getfpscr", H_getfpscr); REG("setfpscr", H_setfpscr);
+            REG("pk", H_pk); REG("cpget1", H_cpget1); REG("cpcall", H_cpcall);
+            REG("fadd32", H_fadd32); REG("fsub32", H_fsub32); REG("fmul32", H_fmul32); REG("fdiv32", H_fdiv32); REG("fsqrt32", H_fsqrt32);
+            REG("fadd64", H_fadd64); REG("fsub64", H_fsub64); REG("fmul64", H_fmul64); REG("fdiv64", H_fdiv64); REG("fsqrt64", H_fsqrt64);
+            REG("fcmp32", H_fcmp32); REG("fcmp64", H_fcmp64); REG("fs2d", H_fs2d); REG("fd2s", H_fd2s); REG("ftoi", H_ftoi); REG("itof", H_itof);
+#undef REG
+        }
+        st.ctx = static_cast<u32>(reinterpret_cast<uintptr_t>(this));
+        js_id = jit_js_new_impl();
+    }
+
+    UserConfig conf;
+    Backend::Wasm::A32JitState st;
+    static constexpr u32 kLinkEntries = 1u << 14;
+    std::unordered_map<u64, u32> cache;  // location descriptor -> slot in the function table
+    std::vector<Backend::Wasm::LinkEntry> link = std::vector<Backend::Wasm::LinkEntry>(kLinkEntries, Backend::Wasm::LinkEntry{0xFFFFFFFFu, 0, 0, 0});
+    int js_id = -1;
+    u32 next_slot = 0;
+    bool invalidate_pending = false;
+    std::vector<std::pair<u32, u32>> slot_range;                 // guest [start, end) covered by the block in each table slot
+    std::vector<std::pair<u32, u32>> pending_ranges;             // InvalidateCacheRange requests that arrived while code was running: {start, size}
+    std::string last_error;
+
+    static Impl* I(u32 ctx) { return reinterpret_cast<Impl*>(static_cast<uintptr_t>(ctx)); }
+
+    // ----- host functions called from generated code -----
+    static u32 Crumbs() { static const u32 n = std::getenv("JIT_CRUMB") ? static_cast<u32>(std::atoi(std::getenv("JIT_CRUMB"))) : 0; return n; }
+    u32 crumb_n = 0;
+    static inline bool hc_on = false;   // helper crumbs: switched on once JIT_CRUMBH blocks have been compiled (so the log is not flooded from the start)
+    static void HC(u32 kind, u32 va, u32 c) { if (hc_on) jit_js_crumb(10 + kind, va, I(c)->st.regs[15]); }
+    static bool Trace() { static const bool t = std::getenv("JIT_TRACE") != nullptr && std::getenv("JIT_TRACE")[0] == '2'; return t; }
+    static u32 H_r8(u32 c, u32 va) { HC(0, va, c); if (Trace()) std::fprintf(stderr, "[jit] r8  %08x pc=%08x\n", va, I(c)->st.regs[15]); return I(c)->conf.callbacks->MemoryRead8(va); }
+    static u32 H_r16(u32 c, u32 va) { HC(1, va, c); if (Trace()) std::fprintf(stderr, "[jit] r16 %08x\n", va); return I(c)->conf.callbacks->MemoryRead16(va); }
+    static u32 H_r32(u32 c, u32 va) { HC(2, va, c); if (Trace()) std::fprintf(stderr, "[jit] r32 %08x\n", va); return I(c)->conf.callbacks->MemoryRead32(va); }
+    static u64 H_r64(u32 c, u32 va) { HC(3, va, c); return I(c)->conf.callbacks->MemoryRead64(va); }
+    static void H_w8(u32 c, u32 va, u32 v) { HC(4, va, c); I(c)->conf.callbacks->MemoryWrite8(va, static_cast<u8>(v)); }
+    static void H_w16(u32 c, u32 va, u32 v) { HC(5, va, c); I(c)->conf.callbacks->MemoryWrite16(va, static_cast<u16>(v)); }
+    static void H_w32(u32 c, u32 va, u32 v) { HC(6, va, c); I(c)->conf.callbacks->MemoryWrite32(va, v); }
+    static void H_w64(u32 c, u32 va, u64 v) { HC(7, va, c); I(c)->conf.callbacks->MemoryWrite64(va, v); }
+
+    template<typename T, typename RD>
+    static T ExclusiveRead(Impl* i, u32 va, RD rd) {
+        return i->conf.global_monitor->template ReadAndMark<T>(i->conf.processor_id, va, rd);
+    }
+    static u32 H_xr8(u32 c, u32 va) { auto* i = I(c); return ExclusiveRead<u8>(i, va, [&] { return i->conf.callbacks->MemoryRead8(va); }); }
+    static u32 H_xr16(u32 c, u32 va) { auto* i = I(c); return ExclusiveRead<u16>(i, va, [&] { return i->conf.callbacks->MemoryRead16(va); }); }
+    static u32 H_xr32(u32 c, u32 va) { auto* i = I(c); return ExclusiveRead<u32>(i, va, [&] { return i->conf.callbacks->MemoryRead32(va); }); }
+    static u64 H_xr64(u32 c, u32 va) { auto* i = I(c); return ExclusiveRead<u64>(i, va, [&] { return i->conf.callbacks->MemoryRead64(va); }); }
+    static u32 H_xw8(u32 c, u32 va, u32 v) { auto* i = I(c); return i->conf.global_monitor->DoExclusiveOperation<u8>(i->conf.processor_id, va, [&](u8 e) { return i->conf.callbacks->MemoryWriteExclusive8(va, static_cast<u8>(v), e); }) ? 0 : 1; }
+    static u32 H_xw16(u32 c, u32 va, u32 v) { auto* i = I(c); return i->conf.global_monitor->DoExclusiveOperation<u16>(i->conf.processor_id, va, [&](u16 e) { return i->conf.callbacks->MemoryWriteExclusive16(va, static_cast<u16>(v), e); }) ? 0 : 1; }
+    static u32 H_xw32(u32 c, u32 va, u32 v) { auto* i = I(c); return i->conf.global_monitor->DoExclusiveOperation<u32>(i->conf.processor_id, va, [&](u32 e) { return i->conf.callbacks->MemoryWriteExclusive32(va, v, e); }) ? 0 : 1; }
+    static u32 H_xw64(u32 c, u32 va, u64 v) { auto* i = I(c); return i->conf.global_monitor->DoExclusiveOperation<u64>(i->conf.processor_id, va, [&](u64 e) { return i->conf.callbacks->MemoryWriteExclusive64(va, v, e); }) ? 0 : 1; }
+    static void H_clrex(u32 c) { auto* i = I(c); if (i->conf.global_monitor) i->conf.global_monitor->ClearProcessor(i->conf.processor_id); }
+
+    // Callbacks that may run guest-visible code (SVC, exceptions) get exact tick accounting around them.
+    template<typename F>
+    static void WithTicks(Impl* i, F f) {
+        auto& s = i->st;
+        if (i->conf.enable_cycle_counting) { jit_js_stat(0, static_cast<double>(s.cycles_to_run - s.ticks_left)); i->conf.callbacks->AddTicks(s.cycles_to_run - s.ticks_left); }
+        f();
+        if (i->conf.enable_cycle_counting) {
+            s.cycles_to_run = i->conf.callbacks->GetTicksRemaining();
+            s.ticks_left = s.cycles_to_run;
+        }
+    }
+    static void H_svc(u32 c, u32 imm) { auto* i = I(c); if (Crumbs() != 0) jit_js_crumb(3, i->st.regs[15], imm); if (std::getenv("JIT_TRACE")) std::fprintf(stderr, "[jit] svc %02x r0=%08x r1=%08x r2=%08x sp=%08x\n", imm, i->st.regs[0], i->st.regs[1], i->st.regs[2], i->st.regs[13]); WithTicks(i, [&] { i->conf.callbacks->CallSVC(imm); }); }
+    static void H_exc(u32 c, u32 pc, u32 ex) { auto* i = I(c); WithTicks(i, [&] { i->conf.callbacks->ExceptionRaised(pc, static_cast<Exception>(ex)); }); }
+    static void H_interp(u32 c, u32 pc, u32 n) { auto* i = I(c); WithTicks(i, [&] { i->conf.callbacks->InterpreterFallback(pc, n); }); }
+    static void H_isb(u32 c) { I(c)->conf.callbacks->InstructionSynchronizationBarrierRaised(); }
+    static u32 H_getcpsr(u32 c) { return I(c)->st.Cpsr(); }
+    static void H_setcpsr(u32 c, u32 v) { I(c)->st.SetCpsr(v); }
+    static u32 H_getfpscr(u32 c) { return I(c)->st.Fpscr(); }
+    static void H_setfpscr(u32 c, u32 v) { I(c)->st.SetFpscr(v); }
+    static u32 H_cpget1(u32, u32 fn, u32 ua, u32 a0, u32 a1) {
+        return static_cast<u32>(reinterpret_cast<std::uint64_t (*)(void*, u32, u32)>(static_cast<uintptr_t>(fn))(reinterpret_cast<void*>(static_cast<uintptr_t>(ua)), a0, a1));
+    }
+    static void H_cpcall(u32, u32 fn, u32 ua, u32 a0, u32 a1) {
+        reinterpret_cast<std::uint64_t (*)(void*, u32, u32)>(static_cast<uintptr_t>(fn))(reinterpret_cast<void*>(static_cast<uintptr_t>(ua)), a0, a1);
+    }
+
+    // ----- VFP -----
+    template<typename F>
+    static auto Fp(u32 c, u32 fpcr, F f) {
+        auto* i = I(c);
+        if (hc_on) jit_js_crumb(20, i->st.regs[15], fpcr);   // 20 = entering a soft-float helper
+        FP::FPSR sr{i->st.fpsr};
+        auto r = f(FP::FPCR{fpcr}, sr);
+        if (hc_on) jit_js_crumb(21, i->st.regs[15], fpcr);   // 21 = left it
+        i->st.fpsr = sr.Value();
+        return r;
+    }
+#define FP2(NAME, T, FN) static T NAME(u32 c, u32 fpcr, T a, T b) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::FN<T>(a, b, cr, sr); }); }
+    FP2(H_fadd32, u32, Add) FP2(H_fsub32, u32, Sub) FP2(H_fmul32, u32, Mul) FP2(H_fdiv32, u32, Div)
+    FP2(H_fadd64, u64, Add) FP2(H_fsub64, u64, Sub) FP2(H_fmul64, u64, Mul) FP2(H_fdiv64, u64, Div)
+#undef FP2
+    static u32 H_fsqrt32(u32 c, u32 fpcr, u32 a) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::Sqrt<u32>(a, cr, sr); }); }
+    static u64 H_fsqrt64(u32 c, u32 fpcr, u64 a) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::Sqrt<u64>(a, cr, sr); }); }
+    // Packed halving and saturating arithmetic (ARM UHADD8, SHSUB16, UHASX, UQSUB8, QADD16 ...): kind numbers are fixed in emit_a32.cpp (PK).
+    static u32 H_pk(u32 kind, u32 a, u32 b) {
+        auto sat = [](s64 v, s64 lo, s64 hi) { return v < lo ? lo : (v > hi ? hi : v); };
+        u32 r = 0;
+        if (kind >= 12) {   // saturating, 8 or 16 bit lanes
+            const bool w16 = kind >= 16, sub = (kind & 2) != 0, sgn = (kind & 1) != 0;
+            const int bits = w16 ? 16 : 8, lanes = w16 ? 2 : 4;
+            const s64 lo = sgn ? -(s64(1) << (bits - 1)) : 0, hi = sgn ? (s64(1) << (bits - 1)) - 1 : (s64(1) << bits) - 1;
+            for (int i = 0; i < lanes; i++) {
+                const u32 m = (1u << bits) - 1; u32 x = (a >> (i * bits)) & m, y = (b >> (i * bits)) & m;
+                s64 xs = sgn ? static_cast<s64>(static_cast<s32>(x << (32 - bits)) >> (32 - bits)) : x, ys = sgn ? static_cast<s64>(static_cast<s32>(y << (32 - bits)) >> (32 - bits)) : y;
+                r |= (static_cast<u32>(sat(sub ? xs - ys : xs + ys, lo, hi)) & m) << (i * bits);
+            }
+            return r;
+        }
+        const bool sgn = (kind & 1) != 0;
+        auto lane = [&](u32 v, int shift, int bits) -> s64 { const u32 m = (1u << bits) - 1; u32 x = (v >> shift) & m; return sgn ? static_cast<s64>(static_cast<s32>(x << (32 - bits)) >> (32 - bits)) : static_cast<s64>(x); };
+        if (kind < 8) {     // halving add/sub, same lane
+            const bool w16 = kind >= 4, sub = (kind & 2) != 0;
+            const int bits = w16 ? 16 : 8, lanes = w16 ? 2 : 4; const u32 m = (1u << bits) - 1;
+            for (int i = 0; i < lanes; i++) { const s64 x = lane(a, i * bits, bits), y = lane(b, i * bits, bits); r |= (static_cast<u32>((sub ? x - y : x + y) >> 1) & m) << (i * bits); }
+            return r;
+        }
+        // halving exchanged 16-bit forms: kind 8,9 = add on the top half / subtract on the bottom half (UHASX), kind 10,11 = subtract on top / add on bottom (UHSAX)
+        const bool add_top = kind < 10;
+        const s64 hi = add_top ? lane(a, 16, 16) + lane(b, 0, 16) : lane(a, 16, 16) - lane(b, 0, 16);
+        const s64 lo = add_top ? lane(a, 0, 16) - lane(b, 16, 16) : lane(a, 0, 16) + lane(b, 16, 16);
+        return ((static_cast<u32>(hi >> 1) & 0xFFFF) << 16) | (static_cast<u32>(lo >> 1) & 0xFFFF);
+    }
+    static u32 H_fcmp32(u32 c, u32 fpcr, u32 a, u32 b, u32 exc) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::Compare<u32>(a, b, exc != 0, cr, sr); }); }
+    static u32 H_fcmp64(u32 c, u32 fpcr, u64 a, u64 b, u32 exc) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::Compare<u64>(a, b, exc != 0, cr, sr); }); }
+    static u64 H_fs2d(u32 c, u32 fpcr, u32 a, u32 rm) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::SingleToDouble(a, cr, static_cast<FP::RoundingMode>(rm), sr); }); }
+    static u32 H_fd2s(u32 c, u32 fpcr, u64 a, u32 rm) { return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) { return Backend::Wasm::FPSoft::DoubleToSingle(a, cr, static_cast<FP::RoundingMode>(rm), sr); }); }
+    // mode: bit0 = 64-bit float, bit1 = unsigned, bits 2..7 = integer bits, bits 8..15 = fractional bits, bits 16..19 = rounding mode
+    static u32 H_ftoi(u32 c, u32 fpcr, u64 a, u32 mode) {
+        const bool f64 = mode & 1, uns = mode & 2;
+        const size_t ibits = (mode >> 2) & 63, fbits = (mode >> 8) & 255;
+        const auto rm = static_cast<FP::RoundingMode>((mode >> 16) & 15);
+        return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) {
+            return f64 ? Backend::Wasm::FPSoft::ToFixed<u64>(a, ibits, fbits, uns, cr, rm, sr) : Backend::Wasm::FPSoft::ToFixed<u32>(static_cast<u32>(a), ibits, fbits, uns, cr, rm, sr);
+        });
+    }
+    static u64 H_itof(u32 c, u32 fpcr, u32 a, u32 mode) {
+        const bool f64 = mode & 1, uns = mode & 2;
+        const size_t ibits = (mode >> 2) & 63, fbits = (mode >> 8) & 255;
+        const auto rm = static_cast<FP::RoundingMode>((mode >> 16) & 15);
+        return Fp(c, fpcr, [&](FP::FPCR cr, FP::FPSR& sr) -> u64 {
+            return f64 ? Backend::Wasm::FPSoft::FromFixed<u64>(a, ibits, fbits, uns, cr, rm, sr) : Backend::Wasm::FPSoft::FromFixed<u32>(a, ibits, fbits, uns, cr, rm, sr);
+        });
+    }
+
+    // ----- translation -----
+    void InstallLink(u64 key, u32 slot) {
+        const u32 pc = static_cast<u32>(key), upper = static_cast<u32>(key >> 32);
+        link[(pc >> 1) & (kLinkEntries - 1)] = {pc, upper, slot, 0};
+    }
+
+    // Returns the function-table slot of the block at the current location, translating it if necessary; -1 on failure.
+    int GetBlock() {
+        const u64 key = st.GetLocationDescriptor().Value();
+        if (auto it = cache.find(key); it != cache.end()) {
+            InstallLink(key, it->second);
+            return static_cast<int>(it->second);
+        }
+
+        const LocationDescriptor loc{IR::LocationDescriptor{key}};
+        static const bool trace = std::getenv("JIT_TRACE") != nullptr;
+        if (trace) std::fprintf(stderr, "[jit] translate pc=%08x thumb=%d fpscr=%08x\n", loc.PC(), loc.TFlag() ? 1 : 0, loc.FPSCR().Value());
+        if (Crumbs() != 0) jit_js_crumb(6, loc.PC(), 0);   // 6 = about to translate
+        const double t_gen0 = jit_now_ms();
+        IR::Block ir = Translate(loc, conf.callbacks, {conf.arch_version, conf.define_unpredictable_behaviour, conf.hook_hint_instructions});
+        if (Crumbs() != 0) jit_js_crumb(7, loc.PC(), 0);   // 7 = translated, optimizing
+        Optimization::A32GetSetElimination(ir, {});
+        Optimization::DeadCodeElimination(ir);
+        Optimization::ConstantPropagation(ir);
+        Optimization::DeadCodeElimination(ir);
+        Optimization::IdentityRemovalPass(ir);
+
+        Backend::Wasm::EmitOptions opt;
+        opt.link_base = static_cast<u32>(reinterpret_cast<uintptr_t>(link.data()));
+        opt.link_mask = kLinkEntries - 1;
+        // debugging switches (environment variables, or Module.ENV in the browser)
+        static const bool no_chain = std::getenv("JIT_NOCHAIN") != nullptr;
+        static const bool chain_tail = std::getenv("JIT_CHAIN_TAIL") != nullptr;   // wasm tail calls (crash WebContent on iPhone, fast on desktop engines)
+        static const bool slow_fp = std::getenv("JIT_SLOW_FP") != nullptr;       // force the soft-float helpers
+        static const bool no_fastmem = std::getenv("JIT_NOFASTMEM") != nullptr;  // always call the memory helpers
+        opt.chain = !no_chain;
+        opt.chain_tail = chain_tail;
+        opt.fast_fp = !slow_fp;
+        if (const char* m = std::getenv("JIT_FPMASK")) opt.fast_fp_mask = static_cast<u32>(std::strtoul(m, nullptr, 0));   // bit per kind: 1 add, 2 sub, 4 mul, 8 div, 16 sqrt, 32 cmp
+        UserConfig emit_conf = conf;
+        if (no_fastmem) { emit_conf.wasm_read_table = nullptr; emit_conf.wasm_write_table = nullptr; }
+        if (Crumbs() != 0) jit_js_crumb(8, loc.PC(), 0);   // 8 = optimized, emitting wasm
+        auto res = Backend::Wasm::EmitA32Block(ir, emit_conf, opt);
+        jit_js_time(0, jit_now_ms() - t_gen0);
+        if (!res.ok()) {
+            char buf[64];
+            std::snprintf(buf, sizeof buf, "block at 0x%08x: ", loc.PC());
+            last_error = std::string(buf) + res.error;
+            std::fprintf(stderr, "[jit] %s\n", last_error.c_str());
+            return -1;
+        }
+        const u32 slot = next_slot++;
+        { static const u32 hc_after = std::getenv("JIT_CRUMBH") ? static_cast<u32>(std::atoi(std::getenv("JIT_CRUMBH"))) : 0xFFFFFFFFu; if (slot >= hc_after) hc_on = true; }
+        if (Crumbs() != 0) jit_js_crumb(1, loc.PC(), slot);   // 1 = compiled a block
+        if (const char* d = std::getenv("JIT_DUMP"); d && static_cast<u32>(std::strtoul(d, nullptr, 16)) == loc.PC()) {   // JIT_DUMP=<guest pc, hex>: write that block's module to jit-dump-<slot>.wasm
+            char fn[64]; std::snprintf(fn, sizeof fn, "jit-dump-%u.wasm", slot);
+            if (FILE* f = std::fopen(fn, "wb")) { std::fwrite(res.bytes.data(), 1, res.bytes.size(), f); std::fclose(f); }
+            std::fprintf(stderr, "[jit] dumped slot %u pc=%08x (%zu bytes) to %s\n", slot, loc.PC(), res.bytes.size(), fn);
+        }
+        if (jit_js_compile(js_id, static_cast<int>(slot), res.bytes.data(), static_cast<int>(res.bytes.size())) < 0) {
+            last_error = "WebAssembly module rejected";
+            return -1;
+        }
+        if (Crumbs() != 0) jit_js_crumb(4, loc.PC(), slot);   // 4 = compile finished
+        cache[key] = slot;
+        {
+            const u32 start = loc.PC(), end = LocationDescriptor{ir.EndLocation()}.PC();
+            if (slot_range.size() <= slot) slot_range.resize(slot + 1);
+            slot_range[slot] = {start, end > start ? end + 4 : start + 4096};   // +4: conservative (the last instruction and a thumb pair); a wrapped end falls back to a page
+        }
+        InstallLink(key, slot);
+        return static_cast<int>(slot);
+    }
+
+    void DropAllBlocks() {
+        const int dropped = static_cast<int>(cache.size());
+        cache.clear();
+        std::fill(link.begin(), link.end(), Backend::Wasm::LinkEntry{0xFFFFFFFFu, 0, 0, 0});
+        next_slot = 0;
+        slot_range.clear();
+        pending_ranges.clear();
+        jit_js_clear(js_id, dropped);
+    }
+
+    // Forgets only the blocks that overlap guest [start, start+size): their table slots stay allocated but are no longer reachable from the
+    // lookup cache or the link cache, so the next visit translates the (possibly changed) code again.
+    void DropRange(u32 start, u32 size) {
+        const u64 end = static_cast<u64>(start) + size;
+        for (auto it = cache.begin(); it != cache.end();) {
+            const auto r = slot_range[it->second];
+            if (static_cast<u64>(r.first) < end && r.second > start) it = cache.erase(it); else ++it;
+        }
+        std::fill(link.begin(), link.end(), Backend::Wasm::LinkEntry{0xFFFFFFFFu, 0, 0, 0});   // chained blocks find their next block through here: rebuilt from `cache` on demand
+    }
+
+    void ApplyPendingRanges() {
+        for (const auto& [start, size] : pending_ranges) DropRange(start, size);
+        pending_ranges.clear();
+    }
+};
+
+Jit::Jit(UserConfig conf) : impl(std::make_unique<Impl>(std::move(conf))) {}
+Jit::~Jit() = default;
+
+HaltReason Jit::Run() {
+    is_executing = true;
+    auto& s = impl->st;
+    auto* cb = impl->conf.callbacks;
+    const bool counting = impl->conf.enable_cycle_counting;
+    const u64 ticks = counting ? cb->GetTicksRemaining() : (u64(1) << 62);
+    s.cycles_to_run = ticks;
+    s.ticks_left = ticks;
+    s.chain_depth = 0;
+    int dispatches = 0;
+
+    while (static_cast<s64>(s.ticks_left) > 0 && s.halt == 0) {
+        const u32 slots_before = impl->next_slot;
+        const int h = impl->GetBlock();
+        if (Impl::Crumbs() != 0 && impl->next_slot != slots_before && h >= 0) jit_js_crumb(5, s.regs[15], static_cast<u32>(h));   // 5 = about to run a freshly compiled block
+        if (h < 0) {
+            s.halt |= static_cast<u32>(HaltReason::UserDefined8);
+            break;
+        }
+        s.chain_depth = 0;
+        if (const u32 ce = Impl::hc_on ? 1u : Impl::Crumbs(); ce != 0 && (++impl->crumb_n % ce) == 0) jit_js_crumb(2, s.regs[15], impl->crumb_n);   // 2 = dispatch
+        ++dispatches;
+        jit_js_run(impl->js_id, h, static_cast<int>(reinterpret_cast<uintptr_t>(&s)));
+        if (impl->invalidate_pending) {
+            impl->invalidate_pending = false;
+            impl->DropAllBlocks();
+            s.halt &= ~static_cast<u32>(HaltReason::CacheInvalidation);
+        } else if (!impl->pending_ranges.empty()) {
+            impl->ApplyPendingRanges();
+            s.halt &= ~static_cast<u32>(HaltReason::CacheInvalidation);
+        }
+    }
+    jit_js_stat(dispatches, counting ? static_cast<double>(s.cycles_to_run - s.ticks_left) : 0.0);
+    if (counting) cb->AddTicks(s.cycles_to_run - s.ticks_left);
+    is_executing = false;
+    return static_cast<HaltReason>(s.halt);
+}
+
+HaltReason Jit::Step() { return HaltReason::Step; }  // not implemented
+
+void Jit::ClearCache() {
+    impl->invalidate_pending = true;
+    if (!is_executing) {
+        impl->invalidate_pending = false;
+        impl->DropAllBlocks();
+    } else {
+        impl->st.halt |= static_cast<u32>(HaltReason::CacheInvalidation);
+    }
+}
+
+void Jit::InvalidateCacheRange(std::uint32_t start, std::size_t size) {
+    impl->pending_ranges.emplace_back(start, static_cast<u32>(size));
+    if (!is_executing) {
+        impl->ApplyPendingRanges();
+    } else {
+        impl->st.halt |= static_cast<u32>(HaltReason::CacheInvalidation);
+    }
+}
+
+void Jit::Reset() {
+    const u32 ctx = impl->st.ctx;
+    impl->st = Backend::Wasm::A32JitState{};
+    impl->st.ctx = ctx;
+}
+
+void Jit::HaltExecution(HaltReason hr) { impl->st.halt |= static_cast<u32>(hr); }
+void Jit::ClearHalt(HaltReason hr) { impl->st.halt &= ~static_cast<u32>(hr); }
+std::array<std::uint32_t, 16>& Jit::Regs() { return impl->st.regs; }
+const std::array<std::uint32_t, 16>& Jit::Regs() const { return impl->st.regs; }
+std::array<std::uint32_t, 64>& Jit::ExtRegs() { return impl->st.ext_regs; }
+const std::array<std::uint32_t, 64>& Jit::ExtRegs() const { return impl->st.ext_regs; }
+std::uint32_t Jit::Cpsr() const { return impl->st.Cpsr(); }
+void Jit::SetCpsr(std::uint32_t value) { impl->st.SetCpsr(value); }
+std::uint32_t Jit::Fpscr() const { return impl->st.Fpscr(); }
+void Jit::SetFpscr(std::uint32_t value) { impl->st.SetFpscr(value); }
+void Jit::ClearExclusiveState() { impl->st.exclusive_state = 0; }
+void Jit::DumpDisassembly() const {}
+std::vector<std::string> Jit::Disassemble() const { return {}; }
+
+}  // namespace Dynarmic::A32
