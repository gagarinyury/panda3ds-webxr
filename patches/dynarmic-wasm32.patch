+            c.I32Const(0);
+            c.Else();
+            if (sg) {
+                // INT_MIN / -1 overflows in wasm (traps); ARM defines the result as INT_MIN
+                Ld(inst->GetArg(0)); c.I32Const(static_cast<s32>(0x80000000u)); c.I32Eq(); c.LocalGet(b); c.I32Const(-1); c.I32Eq(); c.I32And();
+                c.If(I32); c.I32Const(static_cast<s32>(0x80000000u)); c.Else(); Ld(inst->GetArg(0)); c.LocalGet(b); c.I32DivS(); c.End();
+            } else {
+                Ld(inst->GetArg(0)); c.LocalGet(b); c.I32DivU();
+            }
+            c.End();
+            Set(inst);
+            return;
+        }
+
+        // ----- packed operations (ARMv6 SIMD) -----
+        case Opcode::PackedAddU8: EmitPackedAddSub8(inst, false, false); return;
+        case Opcode::PackedAddS8: EmitPackedAddSub8(inst, false, true); return;
+        case Opcode::PackedSubU8: EmitPackedAddSub8(inst, true, false); return;
+        case Opcode::PackedSubS8: EmitPackedAddSub8(inst, true, true); return;
+        case Opcode::PackedAddU16: EmitPackedAddSub16(inst, false, false); return;
+        case Opcode::PackedAddS16: EmitPackedAddSub16(inst, false, true); return;
+        case Opcode::PackedSubU16: EmitPackedAddSub16(inst, true, false); return;
+        case Opcode::PackedSubS16: EmitPackedAddSub16(inst, true, true); return;
+        case Opcode::PackedAddSubU16: EmitPackedMixed16(inst, true, false); return;
+        case Opcode::PackedAddSubS16: EmitPackedMixed16(inst, true, true); return;
+        case Opcode::PackedSubAddU16: EmitPackedMixed16(inst, false, false); return;
+        case Opcode::PackedSubAddS16: EmitPackedMixed16(inst, false, true); return;
+        case Opcode::PackedSelect: {
+            const u32 ge = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(ge);
+            Ld(inst->GetArg(2)); c.LocalGet(ge); c.I32And();
+            Ld(inst->GetArg(1)); c.LocalGet(ge); c.I32Const(-1); c.I32Xor(); c.I32And();
+            c.I32Or();
+            Set(inst);
+            return;
+        }
+        case Opcode::PackedAbsDiffSumU8: EmitPackedAbsDiffSum8(inst); return;
+#define PK(op, id) case Opcode::op: c.I32Const(id); Ld(inst->GetArg(0)); Ld(inst->GetArg(1)); CallHelper("pk"); Set(inst); return;
+        PK(PackedHalvingAddU8, 0) PK(PackedHalvingAddS8, 1) PK(PackedHalvingSubU8, 2) PK(PackedHalvingSubS8, 3)
+        PK(PackedHalvingAddU16, 4) PK(PackedHalvingAddS16, 5) PK(PackedHalvingSubU16, 6) PK(PackedHalvingSubS16, 7)
+        PK(PackedHalvingAddSubU16, 8) PK(PackedHalvingAddSubS16, 9) PK(PackedHalvingSubAddU16, 10) PK(PackedHalvingSubAddS16, 11)
+        PK(PackedSaturatedAddU8, 12) PK(PackedSaturatedAddS8, 13) PK(PackedSaturatedSubU8, 14) PK(PackedSaturatedSubS8, 15)
+        PK(PackedSaturatedAddU16, 16) PK(PackedSaturatedAddS16, 17) PK(PackedSaturatedSubU16, 18) PK(PackedSaturatedSubS16, 19)
+#undef PK
+
+        // ----- saturation -----
+        case Opcode::SignedSaturatedAddWithFlag32: {
+            const u32 al = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(al);
+            const u32 bl = Tmp(I32); Ld(inst->GetArg(1)); c.LocalSet(bl);
+            const u32 sum = Tmp(I32);
+            c.LocalGet(al); c.LocalGet(bl); c.I32Add(); c.LocalSet(sum);
+            const u32 ovl = Tmp(I32);
+            c.LocalGet(sum); c.LocalGet(al); c.I32Xor();
+            c.LocalGet(sum); c.LocalGet(bl); c.I32Xor();
+            c.I32And(); c.I32Const(31); c.I32ShrU(); c.LocalSet(ovl);
