+            // saturated value: (sum >> 31) ^ 0x80000000 (INT_MAX if sum < 0, INT_MIN if sum >= 0)
+            c.LocalGet(sum); c.I32Const(31); c.I32ShrS(); c.I32Const(static_cast<s32>(0x80000000u)); c.I32Xor();
+            c.LocalGet(sum);
+            c.LocalGet(ovl);
+            c.Select();
+            const u32 res = Tmp(I32);
+            c.LocalSet(res);
+            Alias(inst, res);
+            if (auto* ov = P(inst, Opcode::GetOverflowFromOp)) {
+                Alias(ov, ovl);
+            }
+            return;
+        }
+        case Opcode::SignedSaturatedSubWithFlag32: {
+            const u32 al = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(al);
+            const u32 bl = Tmp(I32); Ld(inst->GetArg(1)); c.LocalSet(bl);
+            const u32 diff = Tmp(I32);
+            c.LocalGet(al); c.LocalGet(bl); c.I32Sub(); c.LocalSet(diff);
+            const u32 ovl = Tmp(I32);
+            c.LocalGet(al); c.LocalGet(bl); c.I32Xor();
+            c.LocalGet(al); c.LocalGet(diff); c.I32Xor();
+            c.I32And(); c.I32Const(31); c.I32ShrU(); c.LocalSet(ovl);
+
+            // saturated value: (diff >> 31) ^ 0x80000000
+            c.LocalGet(diff); c.I32Const(31); c.I32ShrS(); c.I32Const(static_cast<s32>(0x80000000u)); c.I32Xor();
+            c.LocalGet(diff);
+            c.LocalGet(ovl);
+            c.Select();
+            const u32 res = Tmp(I32);
+            c.LocalSet(res);
+            Alias(inst, res);
+            if (auto* ov = P(inst, Opcode::GetOverflowFromOp)) {
+                Alias(ov, ovl);
+            }
+            return;
+        }
+        case Opcode::SignedSaturation: {
