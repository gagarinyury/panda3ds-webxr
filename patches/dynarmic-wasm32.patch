@@ -0,0 +1,237 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "dynarmic/backend/wasm/fp_soft.h"
+
+#include <mcl/bit/bit_count.hpp>
+
+#include "dynarmic/common/fp/fused.h"
+#include "dynarmic/common/fp/info.h"
+#include "dynarmic/common/fp/op/FPConvert.h"
+#include "dynarmic/common/fp/op/FPToFixed.h"
+#include "dynarmic/common/fp/process_exception.h"
+#include "dynarmic/common/fp/process_nan.h"
+#include "dynarmic/common/fp/unpacked.h"
+
+namespace Dynarmic::Backend::Wasm::FPSoft {
+
+using namespace Dynarmic::FP;
+
+namespace {
+
+constexpr FPUnpacked kOne = {false, 0, u64(1) << normalized_point_position};
+
+template<typename FPT>
+FPT AddSub(FPT op1, FPT op2, bool negate2, FPCR fpcr, FPSR& fpsr) {
+    const RoundingMode rounding = fpcr.RMode();
+    auto [type1, sign1, value1] = FPUnpack(op1, fpcr, fpsr);
+    auto [type2, sign2, value2] = FPUnpack(op2, fpcr, fpsr);
+
+    // NaN operands propagate unchanged (a negated NaN keeps its own sign), so look at them before negating.
+    if (const auto nan = FPProcessNaNs(type1, type2, op1, op2, fpcr, fpsr)) return *nan;
+
+    if (negate2) {
+        sign2 = !sign2;
+        value2.sign = !value2.sign;
+    }
+    const bool inf1 = type1 == FPType::Infinity, inf2 = type2 == FPType::Infinity;
+    const bool zero1 = type1 == FPType::Zero, zero2 = type2 == FPType::Zero;
+
+    if (inf1 && inf2 && sign1 == !sign2) {
+        FPProcessException(FPExc::InvalidOp, fpcr, fpsr);
+        return FPInfo<FPT>::DefaultNaN();
+    }
+    if ((inf1 && !sign1) || (inf2 && !sign2)) return FPInfo<FPT>::Infinity(false);
+    if ((inf1 && sign1) || (inf2 && sign2)) return FPInfo<FPT>::Infinity(true);
+    if (zero1 && zero2 && sign1 == sign2) return FPInfo<FPT>::Zero(sign1);
+
+    const FPUnpacked result = FusedMulAdd(value1, value2, kOne);  // value1 + value2 * 1, exact
+    if (result.mantissa == 0) return FPInfo<FPT>::Zero(rounding == RoundingMode::TowardsMinusInfinity);
+    return FPRound<FPT>(result, fpcr, fpsr);
+}
+
+// Unsigned 128/64 -> quotient and "remainder != 0" without 128-bit division intrinsics.
+inline bool DivideNumerator(u64 num_hi, u64 num_lo, u64 den, u64& quotient) {
+    // Restoring division of the 128-bit value (num_hi:num_lo) by den; quotient must fit in 64 bits (num_hi < den).
+    u64 rem = num_hi;
+    u64 q = 0;
+    for (int i = 63; i >= 0; i--) {
+        const bool carry = rem >> 63;
+        rem = (rem << 1) | ((num_lo >> i) & 1);
+        q <<= 1;
+        if (carry || rem >= den) {
+            rem -= den;
+            q |= 1;
+        }
+    }
+    quotient = q;
+    return rem != 0;
+}
+
+inline u64 IntSqrt128(u64 hi, u64 lo, bool& inexact) {
+    // floor(sqrt(hi:lo)) by the classic restoring method over bit pairs; hi:lo < 2^126 so the result fits in 63 bits.
+    unsigned __int128 x = (static_cast<unsigned __int128>(hi) << 64) | lo, res = 0, bit = static_cast<unsigned __int128>(1) << 126;
+    while (bit > x) bit >>= 2;
+    while (bit != 0) {
+        if (x >= res + bit) {
+            x -= res + bit;
+            res = (res >> 1) + bit;
+        } else {
+            res >>= 1;
+        }
+        bit >>= 2;
+    }
+    inexact = x != 0;
+    return static_cast<u64>(res);
+}
+
+}  // namespace
+
+template<typename FPT>
+FPT Add(FPT a, FPT b, FPCR fpcr, FPSR& fpsr) { return AddSub<FPT>(a, b, false, fpcr, fpsr); }
+template<typename FPT>
+FPT Sub(FPT a, FPT b, FPCR fpcr, FPSR& fpsr) { return AddSub<FPT>(a, b, true, fpcr, fpsr); }
+
+template<typename FPT>
+FPT Mul(FPT op1, FPT op2, FPCR fpcr, FPSR& fpsr) {
+    const auto [type1, sign1, value1] = FPUnpack(op1, fpcr, fpsr);
+    const auto [type2, sign2, value2] = FPUnpack(op2, fpcr, fpsr);
+    if (const auto nan = FPProcessNaNs(type1, type2, op1, op2, fpcr, fpsr)) return *nan;
+
+    const bool inf1 = type1 == FPType::Infinity, inf2 = type2 == FPType::Infinity;
+    const bool zero1 = type1 == FPType::Zero, zero2 = type2 == FPType::Zero;
+    if ((inf1 && zero2) || (zero1 && inf2)) {
+        FPProcessException(FPExc::InvalidOp, fpcr, fpsr);
+        return FPInfo<FPT>::DefaultNaN();
+    }
+    if (inf1 || inf2) return FPInfo<FPT>::Infinity(sign1 != sign2);
+    if (zero1 || zero2) return FPInfo<FPT>::Zero(sign1 != sign2);
+
+    const FPUnpacked zero = {false, 0, 0};
+    return FPRound<FPT>(FusedMulAdd(zero, value1, value2), fpcr, fpsr);
+}
+
+template<typename FPT>
+FPT Div(FPT op1, FPT op2, FPCR fpcr, FPSR& fpsr) {
+    const auto [type1, sign1, value1] = FPUnpack(op1, fpcr, fpsr);
+    const auto [type2, sign2, value2] = FPUnpack(op2, fpcr, fpsr);
+    if (const auto nan = FPProcessNaNs(type1, type2, op1, op2, fpcr, fpsr)) return *nan;
+
+    const bool inf1 = type1 == FPType::Infinity, inf2 = type2 == FPType::Infinity;
+    const bool zero1 = type1 == FPType::Zero, zero2 = type2 == FPType::Zero;
+    if ((inf1 && inf2) || (zero1 && zero2)) {
+        FPProcessException(FPExc::InvalidOp, fpcr, fpsr);
+        return FPInfo<FPT>::DefaultNaN();
+    }
+    if (inf1 || zero2) {
+        if (!inf1) FPProcessException(FPExc::DivideByZero, fpcr, fpsr);
+        return FPInfo<FPT>::Infinity(sign1 != sign2);
+    }
+    if (zero1 || inf2) return FPInfo<FPT>::Zero(sign1 != sign2);
+
+    // value1 / value2 = (m1 / m2) * 2^(e1 - e2) with m in [1,2) represented at point position 62.
+    // quotient = floor(m1 * 2^62 / m2) as a 64-bit value in (2^61, 2^63); a non-zero remainder becomes a sticky low bit.
+    u64 q = 0;
+    const u64 num_hi = value1.mantissa >> 2;           // (m1 << 62) as a 128-bit number: high part
+    const u64 num_lo = value1.mantissa << 62;          // low part
+    const bool inexact = DivideNumerator(num_hi, num_lo, value2.mantissa, q);
+    const FPUnpacked result = ToNormalized(sign1 != sign2, value1.exponent - value2.exponent, q | static_cast<u64>(inexact));
+    // ToNormalized treats `q` as an integer scaled by 2^exponent; q already carries 2^-62 scaling, so compensate.
+    FPUnpacked fixed = result;
+    fixed.exponent -= static_cast<int>(normalized_point_position);
+    return FPRound<FPT>(fixed, fpcr, fpsr);
+}
+
+template<typename FPT>
+FPT Sqrt(FPT op, FPCR fpcr, FPSR& fpsr) {
+    const auto [type, sign, value] = FPUnpack(op, fpcr, fpsr);
+    if (type == FPType::SNaN || type == FPType::QNaN) return FPProcessNaN(type, op, fpcr, fpsr);
+    if (type == FPType::Zero) return FPInfo<FPT>::Zero(sign);
+    if (type == FPType::Infinity && !sign) return FPInfo<FPT>::Infinity(false);
+    if (sign) {
+        FPProcessException(FPExc::InvalidOp, fpcr, fpsr);
+        return FPInfo<FPT>::DefaultNaN();
+    }
+    // value = (m / 2^62) * 2^e, m in [2^62, 2^63).  Make the exponent even, then sqrt(m' * 2^62) / 2^62 * 2^(e'/2).
+    int e = value.exponent;
+    u64 m = value.mantissa;
+    unsigned __int128 n;
+    if (e & 1) {  // odd exponent (works for negative e: e & 1 is 1 for odd in two's complement)
+        n = static_cast<unsigned __int128>(m) << 63;  // m' = m * 2
+        e -= 1;
+    } else {
+        n = static_cast<unsigned __int128>(m) << 62;
+    }
+    bool inexact = false;
+    const u64 r = IntSqrt128(static_cast<u64>(n >> 64), static_cast<u64>(n), inexact);
+    FPUnpacked result = ToNormalized(false, e / 2, r | static_cast<u64>(inexact));
+    result.exponent -= static_cast<int>(normalized_point_position);
+    return FPRound<FPT>(result, fpcr, fpsr);
+}
+
+template<typename FPT>
+u32 Compare(FPT a, FPT b, bool exc_on_qnan, FPCR fpcr, FPSR& fpsr) {
+    const auto [type1, sign1, value1] = FPUnpack(a, fpcr, fpsr);
+    const auto [type2, sign2, value2] = FPUnpack(b, fpcr, fpsr);
+    const bool nan1 = type1 == FPType::QNaN || type1 == FPType::SNaN;
+    const bool nan2 = type2 == FPType::QNaN || type2 == FPType::SNaN;
+    if (nan1 || nan2) {
+        if (type1 == FPType::SNaN || type2 == FPType::SNaN || exc_on_qnan) FPProcessException(FPExc::InvalidOp, fpcr, fpsr);
+        return 0x30000000;  // unordered: C and V
+    }
+    // Order the (flushed) values. Zero compares equal regardless of sign.
+    auto cmp = [](FPType t1, bool s1, const FPUnpacked& v1, FPType t2, bool s2, const FPUnpacked& v2) -> int {
+        auto key_sign = [](FPType t, bool s) { return t == FPType::Zero ? 0 : (s ? -1 : 1); };
+        const int k1 = key_sign(t1, s1), k2 = key_sign(t2, s2);
+        if (k1 != k2) return k1 < k2 ? -1 : 1;
+        if (k1 == 0) return 0;
+        // same sign, both non-zero: compare magnitudes
+        int mag;
+        if (t1 == FPType::Infinity || t2 == FPType::Infinity) mag = (t1 == FPType::Infinity) - (t2 == FPType::Infinity);
+        else if (v1.exponent != v2.exponent) mag = v1.exponent < v2.exponent ? -1 : 1;
+        else mag = v1.mantissa == v2.mantissa ? 0 : (v1.mantissa < v2.mantissa ? -1 : 1);
+        return k1 > 0 ? mag : -mag;
+    };
+    const int c = cmp(type1, sign1, value1, type2, sign2, value2);
+    if (c == 0) return 0x60000000;   // equal: Z, C
+    if (c < 0) return 0x80000000;    // less: N
+    return 0x20000000;               // greater: C
+}
+
+u64 SingleToDouble(u32 a, FPCR fpcr, RoundingMode rm, FPSR& fpsr) { return FPConvert<u64, u32>(a, fpcr, rm, fpsr); }
+u32 DoubleToSingle(u64 a, FPCR fpcr, RoundingMode rm, FPSR& fpsr) { return FPConvert<u32, u64>(a, fpcr, rm, fpsr); }
+
+template<typename FPT>
+u32 ToFixed(FPT a, size_t ibits, size_t fbits, bool is_unsigned, FPCR fpcr, RoundingMode rm, FPSR& fpsr) {
+    return static_cast<u32>(FPToFixed<FPT>(ibits, a, fbits, is_unsigned, fpcr, rm, fpsr));
+}
+
+template<typename FPT>
+FPT FromFixed(u32 value, size_t ibits, size_t fbits, bool is_unsigned, FPCR fpcr, RoundingMode rm, FPSR& fpsr) {
+    bool sign = false;
+    u64 mag = value;
+    if (ibits < 32) mag &= (u64(1) << ibits) - 1;
+    if (!is_unsigned) {
+        const u64 sign_bit = u64(1) << (ibits - 1);
+        if (mag & sign_bit) {
+            sign = true;
+            mag = ((u64(1) << ibits) - mag) & ((u64(1) << ibits) - 1);
+            if (mag == 0) mag = u64(1) << ibits;  // most negative value
+        }
+    }
+    if (mag == 0) return FPInfo<FPT>::Zero(false);
+    return FPRound<FPT>(ToNormalized(sign, -static_cast<int>(fbits), mag), fpcr, rm, fpsr);
+}
+
+#define INST(T)                                                                                              \
+    template T Add<T>(T, T, FPCR, FPSR&);   template T Sub<T>(T, T, FPCR, FPSR&);                           \
+    template T Mul<T>(T, T, FPCR, FPSR&);   template T Div<T>(T, T, FPCR, FPSR&);                           \
+    template T Sqrt<T>(T, FPCR, FPSR&);     template u32 Compare<T>(T, T, bool, FPCR, FPSR&);               \
+    template u32 ToFixed<T>(T, size_t, size_t, bool, FPCR, RoundingMode, FPSR&);                            \
+    template T FromFixed<T>(u32, size_t, size_t, bool, FPCR, RoundingMode, FPSR&);
+INST(u32)
+INST(u64)
+#undef INST
+
+}  // namespace Dynarmic::Backend::Wasm::FPSoft
