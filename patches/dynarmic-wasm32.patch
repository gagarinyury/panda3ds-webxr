+                        : (op == Opcode::FPMul32 || op == Opcode::FPMul64) ? 2 : 3;
+            PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); Ld(inst->GetArg(1));
