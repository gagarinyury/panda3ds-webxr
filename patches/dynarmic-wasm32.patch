+        // ----- VFP scalar floating point (bit-exact soft-float helpers; FPCR is known per block) -----
+        case Opcode::FPAdd32: if (FastFp32(inst, 0)) return; goto fp_generic;
+        case Opcode::FPSub32: if (FastFp32(inst, 1)) return; goto fp_generic;
+        case Opcode::FPMul32: if (FastFp32(inst, 2)) return; goto fp_generic;
+        case Opcode::FPDiv32: if (FastFp32(inst, 3)) return; goto fp_generic;
+        case Opcode::FPSqrt32: if (FastFp32(inst, 4)) return; goto fp_generic;
