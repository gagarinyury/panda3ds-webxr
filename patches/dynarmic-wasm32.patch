+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Bit-exact ARM VFP scalar arithmetic on top of Dynarmic's portable soft-float building blocks (FPUnpack/FPRound/FusedMulAdd).
+ * Handles every FPCR mode (rounding, flush-to-zero, default-NaN) and accumulates exception flags into the FPSR.
+ */
+#pragma once
+
+#include <mcl/stdint.hpp>
+
+#include "dynarmic/common/fp/fpcr.h"
+#include "dynarmic/common/fp/fpsr.h"
+#include "dynarmic/common/fp/rounding_mode.h"
+
+namespace Dynarmic::Backend::Wasm::FPSoft {
+
+template<typename FPT> FPT Add(FPT a, FPT b, FP::FPCR fpcr, FP::FPSR& fpsr);
+template<typename FPT> FPT Sub(FPT a, FPT b, FP::FPCR fpcr, FP::FPSR& fpsr);
+template<typename FPT> FPT Mul(FPT a, FPT b, FP::FPCR fpcr, FP::FPSR& fpsr);
+template<typename FPT> FPT Div(FPT a, FPT b, FP::FPCR fpcr, FP::FPSR& fpsr);
+template<typename FPT> FPT Sqrt(FPT a, FP::FPCR fpcr, FP::FPSR& fpsr);
+
+/// VCMP/VCMPE: returns NZCV in bits 31..28.
+template<typename FPT> u32 Compare(FPT a, FPT b, bool exc_on_qnan, FP::FPCR fpcr, FP::FPSR& fpsr);
+
+/// float <-> float
+u64 SingleToDouble(u32 a, FP::FPCR fpcr, FP::RoundingMode rm, FP::FPSR& fpsr);
+u32 DoubleToSingle(u64 a, FP::FPCR fpcr, FP::RoundingMode rm, FP::FPSR& fpsr);
+
+/// float -> fixed/integer (ibits <= 32), result left in the low `ibits` bits (two's complement for signed).
+template<typename FPT> u32 ToFixed(FPT a, size_t ibits, size_t fbits, bool is_unsigned, FP::FPCR fpcr, FP::RoundingMode rm, FP::FPSR& fpsr);
+
+/// fixed/integer (ibits <= 32) -> float
+template<typename FPT> FPT FromFixed(u32 value, size_t ibits, size_t fbits, bool is_unsigned, FP::FPCR fpcr, FP::RoundingMode rm, FP::FPSR& fpsr);
+
+}  // namespace Dynarmic::Backend::Wasm::FPSoft
