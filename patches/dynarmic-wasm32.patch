+    void EmitPackedAbsDiffSum8(IR::Inst* inst) {
+        const u32 al = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(al);
+        const u32 bl = Tmp(I32); Ld(inst->GetArg(1)); c.LocalSet(bl);
+        const u32 acc = Tmp(I32);
+        c.I32Const(0); c.LocalSet(acc);
+        for (int i = 0; i < 4; i++) {
+            const u32 da = Tmp(I32);
+            const u32 db = Tmp(I32);
+            c.LocalGet(al); if (i) { c.I32Const(i * 8); c.I32ShrU(); } c.I32Const(0xff); c.I32And(); c.LocalSet(da);
+            c.LocalGet(bl); if (i) { c.I32Const(i * 8); c.I32ShrU(); } c.I32Const(0xff); c.I32And(); c.LocalSet(db);
+            c.LocalGet(acc);
+            c.LocalGet(da); c.LocalGet(db); c.I32Sub();
+            c.LocalGet(db); c.LocalGet(da); c.I32Sub();
+            c.LocalGet(da); c.LocalGet(db); c.I32GeU();
+            c.Select();
+            c.I32Add();
+            c.LocalSet(acc);
+        }
+        Alias(inst, acc);
+    }
