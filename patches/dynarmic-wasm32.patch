+    // ---------- per-instruction ----------
+    void Bin32(IR::Inst* inst, void (Code::*op)()) {
+        Ld(inst->GetArg(0));
+        Ld(inst->GetArg(1));
+        (c.*op)();
+        const u32 r = Set(inst);
+        EmitNZpseudo(inst, r);
+    }
