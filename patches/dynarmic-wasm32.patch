+            return;
+        }
+        case Opcode::FPFixedS32ToSingle: case Opcode::FPFixedU32ToSingle: case Opcode::FPFixedS16ToSingle: case Opcode::FPFixedU16ToSingle:
+        case Opcode::FPFixedS32ToDouble: case Opcode::FPFixedU32ToDouble: case Opcode::FPFixedS16ToDouble: case Opcode::FPFixedU16ToDouble: {
+            const bool dst64 = op == Opcode::FPFixedS32ToDouble || op == Opcode::FPFixedU32ToDouble || op == Opcode::FPFixedS16ToDouble || op == Opcode::FPFixedU16ToDouble;
+            const bool uns = op == Opcode::FPFixedU32ToSingle || op == Opcode::FPFixedU16ToSingle || op == Opcode::FPFixedU32ToDouble || op == Opcode::FPFixedU16ToDouble;
+            const u32 ibits = (op == Opcode::FPFixedS16ToSingle || op == Opcode::FPFixedU16ToSingle || op == Opcode::FPFixedS16ToDouble || op == Opcode::FPFixedU16ToDouble) ? 16 : 32;
+            const u32 mode = (dst64 ? 1u : 0u) | (uns ? 2u : 0u) | (ibits << 2) | (static_cast<u32>(inst->GetArg(1).GetU8()) << 8) | (static_cast<u32>(inst->GetArg(2).GetU8()) << 16);
+            PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); c.I32Const(static_cast<s32>(mode));
+            CallHelper("itof");
