+    // ---------------------------------------------------------------------------------------------------------
+    // Inline VFP (single precision) for round-to-nearest and round-to-zero modes, with flush-to-zero / default-NaN handled here.
+    // Anything involving a NaN (or the one rounding corner we cannot decide) is delegated to the bit-exact soft-float helper, which
+    // also accumulates the exception flags. The inline path does not update FPSR exception bits.
+    // ---------------------------------------------------------------------------------------------------------
+    static constexpr s32 kAbsMask = 0x7fffffff, kSignMask = static_cast<s32>(0x80000000u), kInf = 0x7f800000, kMinNormal = 0x00800000;
+
+    void IsNaN32(u32 bits_local) { c.LocalGet(bits_local); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32GtU(); }
+    void Flush32(u32 src, u32 dst) {  // denormal -> signed zero
+        c.LocalGet(src); c.I32Const(kSignMask); c.I32And();
+        c.LocalGet(src);
+        c.LocalGet(src); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kMinNormal); c.I32LtU();
+        c.Select(); c.LocalSet(dst);
+    }
+    // bits -= 1 (one ulp toward zero) when `cond` (an i32 on the stack) is non-zero
+    void StepTowardZeroIf(u32 bits) {
+        c.If();
+        c.LocalGet(bits); c.I32Const(1); c.I32Sub(); c.LocalSet(bits);
+        c.End();
+    }
+    // if bits is +-inf while all given operands (bit locals) are finite: bits = +-max finite
+    void FixOverflow(u32 bits, std::initializer_list<u32> operands) {
+        c.LocalGet(bits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32Eq();
+        for (u32 o : operands) { c.LocalGet(o); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU(); c.I32And(); }
+        c.If();
+        c.LocalGet(bits); c.I32Const(kSignMask); c.I32And(); c.I32Const(0x7f7fffff); c.I32Or(); c.LocalSet(bits);
+        c.End();
+    }
+
+    // kind: 0 add, 1 sub, 2 mul, 3 div, 4 sqrt
+    bool FastFp32(IR::Inst* inst, int kind) {
+        if (!opt.fast_fp || !((opt.fast_fp_mask >> kind) & 1)) return false;
+        const u32 fpcr = Fpcr();
+        const int rm = (fpcr >> 22) & 3;
+        const bool fz = (fpcr >> 24) & 1;
+        if (rm != 0 && rm != 3) return false;
+        const bool unary = kind == 4, rz = rm == 3;
+
+        const u32 ra = Tmp(I32), rb = Tmp(I32);
+        Ld(inst->GetArg(0)); c.LocalSet(ra);
+        if (unary) { c.I32Const(0); c.LocalSet(rb); } else { Ld(inst->GetArg(1)); c.LocalSet(rb); }
+        u32 ia = ra, ib = rb;
+        if (fz) { ia = Tmp(I32); ib = Tmp(I32); Flush32(ra, ia); if (!unary) Flush32(rb, ib); else { c.I32Const(0); c.LocalSet(ib); } }
+
+        const u32 fa = Tmp(F32), fb = Tmp(F32), rbits = Tmp(I32);
+        c.LocalGet(ia); c.F32ReinterpretI32(); c.LocalSet(fa);
+        c.LocalGet(ib); if (kind == 1) { c.I32Const(kSignMask); c.I32Xor(); } c.F32ReinterpretI32(); c.LocalSet(fb);
+
+        if (!rz) {
+            c.LocalGet(fa);
+            if (kind == 4) c.F32Sqrt(); else { c.LocalGet(fb); if (kind <= 1) c.F32Add(); else if (kind == 2) c.F32Mul(); else c.F32Div(); }
+            c.I32ReinterpretF32(); c.LocalSet(rbits);
+        } else if (kind <= 1) {  // add / sub, round toward zero via the exact TwoSum error
+            const u32 s = Tmp(F32), bb = Tmp(F32), e = Tmp(F32), ebits = Tmp(I32);
+            c.LocalGet(fa); c.LocalGet(fb); c.F32Add(); c.LocalSet(s);
+            c.LocalGet(s); c.LocalGet(fa); c.F32Sub(); c.LocalSet(bb);
+            c.LocalGet(fa); c.LocalGet(s); c.LocalGet(bb); c.F32Sub(); c.F32Sub();
+            c.LocalGet(fb); c.LocalGet(bb); c.F32Sub(); c.F32Add(); c.LocalSet(e);
+            c.LocalGet(s); c.I32ReinterpretF32(); c.LocalSet(rbits);
+            c.LocalGet(e); c.I32ReinterpretF32(); c.LocalSet(ebits);
+            // overshoot: finite s, e != 0 and e has the opposite sign of s
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU();
+            c.LocalGet(ebits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(0); c.I32Ne(); c.I32And();
+            c.LocalGet(ebits); c.LocalGet(rbits); c.I32Xor(); c.I32Const(31); c.I32ShrU(); c.I32And();
+            StepTowardZeroIf(rbits);
+            FixOverflow(rbits, {ia, ib});
+        } else if (kind == 2) {  // mul: the f64 product is exact
+            const u32 p = Tmp(F64), s = Tmp(F32);
+            c.LocalGet(fa); c.F64PromoteF32(); c.LocalGet(fb); c.F64PromoteF32(); c.F64Mul(); c.LocalSet(p);
+            c.LocalGet(p); c.F32DemoteF64(); c.LocalSet(s);
+            c.LocalGet(s); c.I32ReinterpretF32(); c.LocalSet(rbits);
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU();
+            c.LocalGet(s); c.F64PromoteF32(); c.F64Abs(); c.LocalGet(p); c.F64Abs(); c.F64Gt(); c.I32And();
+            StepTowardZeroIf(rbits);
+            FixOverflow(rbits, {ia, ib});
+        } else if (kind == 3) {  // div: remainder a - s*b is exact in f64
+            const u32 s = Tmp(F32), rem = Tmp(F64);
+            c.LocalGet(fa); c.LocalGet(fb); c.F32Div(); c.LocalSet(s);
+            c.LocalGet(s); c.I32ReinterpretF32(); c.LocalSet(rbits);
+            c.LocalGet(fa); c.F64PromoteF32(); c.LocalGet(s); c.F64PromoteF32(); c.LocalGet(fb); c.F64PromoteF32(); c.F64Mul(); c.F64Sub(); c.LocalSet(rem);
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU();            // s finite
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(0); c.I32Ne(); c.I32And();     // s != 0
+            c.LocalGet(rem); c.F64Promote0Ne(); c.I32And();                                              // rem != 0
+            c.LocalGet(rem); c.F64LtZero(); c.LocalGet(ib); c.I32Const(31); c.I32ShrU(); c.I32Xor();     // sign(q - s)
+            c.LocalGet(rbits); c.I32Const(31); c.I32ShrU(); c.I32Ne(); c.I32And();
+            StepTowardZeroIf(rbits);
+            // overflow only when the divisor is a finite non-zero number (x/0 is a true infinity)
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32Eq();
+            c.LocalGet(ia); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU(); c.I32And();
+            c.LocalGet(ib); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU(); c.I32And();
+            c.LocalGet(ib); c.I32Const(kAbsMask); c.I32And(); c.I32Const(0); c.I32Ne(); c.I32And();
+            c.If();
+            c.LocalGet(rbits); c.I32Const(kSignMask); c.I32And(); c.I32Const(0x7f7fffff); c.I32Or(); c.LocalSet(rbits);
+            c.End();
+        } else {  // sqrt
+            const u32 s = Tmp(F32), rem = Tmp(F64);
+            c.LocalGet(fa); c.F32Sqrt(); c.LocalSet(s);
+            c.LocalGet(s); c.I32ReinterpretF32(); c.LocalSet(rbits);
+            c.LocalGet(fa); c.F64PromoteF32(); c.LocalGet(s); c.F64PromoteF32(); c.LocalGet(s); c.F64PromoteF32(); c.F64Mul(); c.F64Sub(); c.LocalSet(rem);
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kInf); c.I32LtU();
+            c.LocalGet(rem); c.F64LtZero(); c.I32And();
+            StepTowardZeroIf(rbits);
+        }
+        if (fz) {  // flush a denormal result
+            c.LocalGet(rbits); c.I32Const(kSignMask); c.I32And();
+            c.LocalGet(rbits);
+            c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kMinNormal); c.I32LtU();
+            c.Select(); c.LocalSet(rbits);
+        }
+        // Delegate to the soft-float helper if a NaN is involved, or (round-to-nearest + flush) the result is exactly the smallest
+        // normal number: the architecture flushes on the *unrounded* magnitude, which we cannot see here.
+        IsNaN32(ra); IsNaN32(rb); c.I32Or(); IsNaN32(rbits); c.I32Or();
+        if (fz && !rz) { c.LocalGet(rbits); c.I32Const(kAbsMask); c.I32And(); c.I32Const(kMinNormal); c.I32Eq(); c.I32Or(); }
+        c.If(I32);
+        PushCtx(); c.I32Const(static_cast<s32>(fpcr)); c.LocalGet(ra);
+        if (!unary) c.LocalGet(rb);
+        { static const char* names[] = {"fadd32", "fsub32", "fmul32", "fdiv32", "fsqrt32"}; CallHelper(names[kind]); }
+        c.Else();
+        c.LocalGet(rbits);
+        c.End();
+        Set(inst);
+        return true;
+    }
+
+    // VCMP: with no NaN involved the result is a plain ordered comparison of the (flushed) operands.
+    bool FastCompare32(IR::Inst* inst) {
+        if (!opt.fast_fp || !((opt.fast_fp_mask >> 5) & 1)) return false;
+        const u32 fpcr = Fpcr();
+        const bool fz = (fpcr >> 24) & 1;
+        const u32 ra = Tmp(I32), rb = Tmp(I32);
+        Ld(inst->GetArg(0)); c.LocalSet(ra);
+        Ld(inst->GetArg(1)); c.LocalSet(rb);
+        u32 ia = ra, ib = rb;
+        if (fz) { ia = Tmp(I32); ib = Tmp(I32); Flush32(ra, ia); Flush32(rb, ib); }
+        const u32 fa = Tmp(F32), fb = Tmp(F32);
+        c.LocalGet(ia); c.F32ReinterpretI32(); c.LocalSet(fa);
+        c.LocalGet(ib); c.F32ReinterpretI32(); c.LocalSet(fb);
+        IsNaN32(ra); IsNaN32(rb); c.I32Or();
+        c.If(I32);
+        PushCtx(); c.I32Const(static_cast<s32>(fpcr)); c.LocalGet(ra); c.LocalGet(rb); Ld(inst->GetArg(2)); CallHelper("fcmp32");
+        c.Else();
+        c.I32Const(0x60000000);                                            // equal
+        c.I32Const(static_cast<s32>(0x80000000u)); c.I32Const(0x20000000); c.LocalGet(fa); c.LocalGet(fb); c.F32Lt(); c.Select();  // less / greater
+        c.LocalGet(fa); c.LocalGet(fb); c.F32Eq();
+        c.Select();
+        c.End();
+        Set(inst);
+        return true;
+    }
+
+    void EmitCoproc(IR::Inst* inst);
+
+    // ---------- module assembly ----------
+    static ValType SigChar(char ch) { return ch == 'l' ? I64 : I32; }
+
+    Bytes Assemble() {
+        // type section: type 0 = block function (i32) -> i32; then one per distinct helper signature
+        std::vector<std::string> sigs;  // signature strings, index = type index - 1
+        auto type_of = [&](const std::string& s) -> u32 {
+            for (size_t i = 0; i < sigs.size(); i++) if (sigs[i] == s) return static_cast<u32>(i + 1);
+            sigs.push_back(s);
+            return static_cast<u32>(sigs.size());
+        };
+        std::vector<u32> import_types;
+        for (const auto& name : import_order) {
+            const char* sig = nullptr;
+            for (const auto& h : kHelpers) if (name == h.name) sig = h.sig;
+            if (!sig) { Fail("unknown helper " + name); return {}; }
+            import_types.push_back(type_of(sig));
+        }
+        Bytes types;
+        LebU(types, 1 + sigs.size());
+        Append(types, Bytes{0x60, 1, I32, 1, I32});
+        for (const auto& s : sigs) {
+            const size_t gt = s.find('>');
+            Bytes t{0x60};
+            LebU(t, gt);
+            for (size_t i = 0; i < gt; i++) t.push_back(SigChar(s[i]));
+            if (s[gt + 1] == 'v') t.push_back(0);
+            else { t.push_back(1); t.push_back(SigChar(s[gt + 1])); }
+            Append(types, t);
+        }
+
+        Bytes imports;
+        LebU(imports, (uses_table ? 2 : 1) + import_order.size());
+        Append(imports, Name("e")); Append(imports, Name("m")); imports.push_back(0x02); imports.push_back(0x00); LebU(imports, 1);
+        if (uses_table) { Append(imports, Name("e")); Append(imports, Name("t")); imports.push_back(0x01); imports.push_back(0x70); imports.push_back(0x00); LebU(imports, 0); }
+        for (size_t i = 0; i < import_order.size(); i++) {
+            Append(imports, Name("e")); Append(imports, Name(import_order[i].c_str()));
+            imports.push_back(0x00); LebU(imports, import_types[i]);
+        }
+
+        Bytes funcs{1, 0};
+        Bytes exports;
+        LebU(exports, 1);
+        Append(exports, Name("b")); exports.push_back(0x00); LebU(exports, import_order.size());
+
+        // code: local declarations (run-length) + body + end
+        Bytes body;
+        std::vector<std::pair<u32, u8>> groups;
+        for (u8 t : extra_locals) {
+            if (!groups.empty() && groups.back().second == t) groups.back().first++;
+            else groups.push_back({1, t});
+        }
+        LebU(body, groups.size());
+        for (auto& g : groups) { LebU(body, g.first); body.push_back(g.second); }
+        Append(body, c.b);
+        body.push_back(0x0b);
+        Bytes code;
+        LebU(code, 1);
+        LebU(code, body.size());
+        Append(code, body);
+
+        Bytes m{0x00, 0x61, 0x73, 0x6d, 1, 0, 0, 0};
+        Append(m, Section(1, types));
+        Append(m, Section(2, imports));
+        Append(m, Section(3, funcs));
+        Append(m, Section(7, exports));
+        Append(m, Section(10, code));
+        return m;
+    }
+};
+
+void Emitter::EmitCoproc(IR::Inst* inst) {
+    const auto info = inst->GetArg(0).GetCoprocInfo();
+    const size_t coproc_num = info[0];
+    const bool two = info[1] == 1;
+    const auto& cp = conf.coprocessors[coproc_num];
+    if (!cp) { Fail("coprocessor not registered"); return; }
+    const IR::Opcode op = inst->GetOpcode();
+    const auto opc1 = static_cast<unsigned>(info[2]);
+    const auto CRn = static_cast<A32::CoprocReg>(info[3]);
+    const auto CRm = static_cast<A32::CoprocReg>(info[4]);
+    const auto opc2 = static_cast<unsigned>(info[5]);
+
+    auto push_callback = [&](const A32::Coprocessor::Callback& cb) {
+        PushCtx();
+        c.I32Const(static_cast<s32>(reinterpret_cast<uintptr_t>(cb.function)));
+        c.I32Const(static_cast<s32>(cb.user_arg ? reinterpret_cast<uintptr_t>(*cb.user_arg) : 0));
+    };
+
+    switch (op) {
+    case Opcode::A32CoprocGetOneWord: {
+        const auto action = cp->CompileGetOneWord(two, opc1, CRn, CRm, opc2);
+        if (auto* ptr = std::get_if<u32*>(&action)) {
+            c.I32Const(static_cast<s32>(reinterpret_cast<uintptr_t>(*ptr)));
+            c.I32Load(0);
+            Set(inst);
+        } else if (auto* cb = std::get_if<A32::Coprocessor::Callback>(&action)) {
+            push_callback(*cb);
+            c.I32Const(0); c.I32Const(0);
+            CallHelper("cpget1");
+            Set(inst);
+        } else {
+            Fail("coprocessor read not supported for this register");
+        }
+        return;
+    }
+    case Opcode::A32CoprocSendOneWord: {
+        const auto action = cp->CompileSendOneWord(two, opc1, CRn, CRm, opc2);
+        if (auto* ptr = std::get_if<u32*>(&action)) {
+            c.I32Const(static_cast<s32>(reinterpret_cast<uintptr_t>(*ptr)));
+            Ld(inst->GetArg(1));
+            c.I32Store(0);
+        } else if (auto* cb = std::get_if<A32::Coprocessor::Callback>(&action)) {
+            push_callback(*cb);
+            Ld(inst->GetArg(1)); c.I32Const(0);
+            CallHelper("cpcall");
+        } else {
+            Fail("coprocessor write not supported for this register");
+        }
+        return;
+    }
+    default:
+        Fail("unsupported coprocessor operation " + IR::GetNameOf(op));
+    }
+}
+
+}  // namespace
+
+EmitResult EmitA32Block(IR::Block& block, const A32::UserConfig& conf, const EmitOptions& opt) {
+    return Emitter(block, conf, opt).Run();
+}
+
+}  // namespace Dynarmic::Backend::Wasm
diff --git a/src/dynarmic/backend/wasm/emit_a32.h b/src/dynarmic/backend/wasm/emit_a32.h
