+        case Opcode::FPAbs64: Ld(inst->GetArg(0)); c.I64Const(0x7fffffffffffffffLL); c.I64And(); Set(inst); return;
+        case Opcode::FPNeg64: Ld(inst->GetArg(0)); c.I64Const(static_cast<s64>(0x8000000000000000ULL)); c.I64Xor(); Set(inst); return;
+        case Opcode::FPCompare32: case Opcode::FPCompare64:
+            if (op == Opcode::FPCompare32 && FastCompare32(inst)) return;
+            PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); Ld(inst->GetArg(1)); Ld(inst->GetArg(2));
+            CallHelper(op == Opcode::FPCompare32 ? "fcmp32" : "fcmp64"); Set(inst);
+            return;
+        case Opcode::FPSingleToDouble:
+            PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); Ld(inst->GetArg(1)); CallHelper("fs2d"); Set(inst);
+            return;
+        case Opcode::FPDoubleToSingle:
+            PushCtx(); c.I32Const(static_cast<s32>(Fpcr())); Ld(inst->GetArg(0)); Ld(inst->GetArg(1)); CallHelper("fd2s"); Set(inst);
+            return;
+        case Opcode::FPSingleToFixedS32: case Opcode::FPSingleToFixedU32: case Opcode::FPSingleToFixedS16: case Opcode::FPSingleToFixedU16:
+        case Opcode::FPDoubleToFixedS32: case Opcode::FPDoubleToFixedU32: case Opcode::FPDoubleToFixedS16: case Opcode::FPDoubleToFixedU16: {
+            const bool src64 = op == Opcode::FPDoubleToFixedS32 || op == Opcode::FPDoubleToFixedU32 || op == Opcode::FPDoubleToFixedS16 || op == Opcode::FPDoubleToFixedU16;
+            const bool uns = op == Opcode::FPSingleToFixedU32 || op == Opcode::FPSingleToFixedU16 || op == Opcode::FPDoubleToFixedU32 || op == Opcode::FPDoubleToFixedU16;
+            const u32 ibits = (op == Opcode::FPSingleToFixedS16 || op == Opcode::FPSingleToFixedU16 || op == Opcode::FPDoubleToFixedS16 || op == Opcode::FPDoubleToFixedU16) ? 16 : 32;
+            const u32 mode = (src64 ? 1u : 0u) | (uns ? 2u : 0u) | (ibits << 2) | (static_cast<u32>(inst->GetArg(1).GetU8()) << 8) | (static_cast<u32>(inst->GetArg(2).GetU8()) << 16);
