+                Set(inst);
+                return;
+            }
+            auto it = local_of.find(src.GetInst());
+            if (it == local_of.end()) { Fail("GetNZFromOp: parent not emitted"); return; }
+            EmitNZ(it->second);
+            Set(inst);
+            return;
