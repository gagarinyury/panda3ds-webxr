@@ -0,0 +1,74 @@
+/* This file is part of the dynarmic project.
+ * Copyright (c) 2016 MerryMage
+ * SPDX-License-Identifier: 0BSD
+ */
+
+#include "dynarmic/backend/wasm/a32_jitstate.h"
+
+#include <mcl/bit/bit_field.hpp>
+#include <mcl/stdint.hpp>
+
+namespace Dynarmic::Backend::Wasm {
+
+u32 A32JitState::Cpsr() const {
+    u32 cpsr = 0;
+
+    // NZCV flags
+    cpsr |= cpsr_nzcv;
+    // Q flag
+    cpsr |= cpsr_q;
+    // GE flags
+    cpsr |= mcl::bit::get_bit<31>(cpsr_ge) ? 1 << 19 : 0;
+    cpsr |= mcl::bit::get_bit<23>(cpsr_ge) ? 1 << 18 : 0;
+    cpsr |= mcl::bit::get_bit<15>(cpsr_ge) ? 1 << 17 : 0;
+    cpsr |= mcl::bit::get_bit<7>(cpsr_ge) ? 1 << 16 : 0;
+    // E flag, T flag
+    cpsr |= mcl::bit::get_bit<1>(upper_location_descriptor) ? 1 << 9 : 0;
+    cpsr |= mcl::bit::get_bit<0>(upper_location_descriptor) ? 1 << 5 : 0;
+    // IT state
+    cpsr |= static_cast<u32>(upper_location_descriptor & 0b11111100'00000000);
+    cpsr |= static_cast<u32>(upper_location_descriptor & 0b00000011'00000000) << 17;
+    // Other flags
+    cpsr |= cpsr_jaifm;
+
+    return cpsr;
+}
+
+void A32JitState::SetCpsr(u32 cpsr) {
+    // NZCV flags
+    cpsr_nzcv = cpsr & 0xF0000000;
+    // Q flag
+    cpsr_q = cpsr & (1 << 27);
+    // GE flags
+    cpsr_ge = 0;
+    cpsr_ge |= mcl::bit::get_bit<19>(cpsr) ? 0xFF000000 : 0;
+    cpsr_ge |= mcl::bit::get_bit<18>(cpsr) ? 0x00FF0000 : 0;
+    cpsr_ge |= mcl::bit::get_bit<17>(cpsr) ? 0x0000FF00 : 0;
+    cpsr_ge |= mcl::bit::get_bit<16>(cpsr) ? 0x000000FF : 0;
+
+    upper_location_descriptor &= 0xFFFF0000;
+    // E flag, T flag
+    upper_location_descriptor |= mcl::bit::get_bit<9>(cpsr) ? 2 : 0;
+    upper_location_descriptor |= mcl::bit::get_bit<5>(cpsr) ? 1 : 0;
+    // IT state
+    upper_location_descriptor |= (cpsr >> 0) & 0b11111100'00000000;
+    upper_location_descriptor |= (cpsr >> 17) & 0b00000011'00000000;
+
+    // Other flags
+    cpsr_jaifm = cpsr & 0x010001DF;
+}
+
+constexpr u32 FPCR_MASK = A32::LocationDescriptor::FPSCR_MODE_MASK;
+constexpr u32 FPSR_MASK = 0x0800'009f;
+
+u32 A32JitState::Fpscr() const {
+    return (upper_location_descriptor & 0xffff'0000) | fpsr | fpsr_nzcv;
+}
+
+void A32JitState::SetFpscr(u32 fpscr) {
+    fpsr_nzcv = fpscr & 0xf000'0000;
+    fpsr = fpscr & FPSR_MASK;
+    upper_location_descriptor = (upper_location_descriptor & 0x0000'ffff) | (fpscr & FPCR_MASK);
+}
+
+}  // namespace Dynarmic::Backend::Wasm
diff --git a/src/dynarmic/backend/wasm/a32_jitstate.h b/src/dynarmic/backend/wasm/a32_jitstate.h
new file mode 100644
index 0000000..95cbcd9
--- /dev/null
+++ b/src/dynarmic/backend/wasm/a32_jitstate.h
@@ -0,0 +1,53 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Layout and CPSR/FPSCR packing follow Dynarmic's arm64 backend (0BSD).
+ */
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+#include <mcl/stdint.hpp>
+
+#include "dynarmic/frontend/A32/a32_location_descriptor.h"
+#include "dynarmic/ir/location_descriptor.h"
+
+namespace Dynarmic::Backend::Wasm {
+
+// Lives in WASM linear memory; generated blocks access it by byte offset (see offsetof uses in emit_a32.cpp).
+struct A32JitState {
+    u32 cpsr_nzcv = 0;
+    u32 cpsr_q = 0;
+    u32 cpsr_jaifm = 0;
+    u32 cpsr_ge = 0;
+
+    u32 fpsr = 0;
+    u32 fpsr_nzcv = 0;
+
+    std::array<u32, 16> regs{};
+
+    u32 upper_location_descriptor = 0;
+
+    alignas(16) std::array<u32, 64> ext_regs{};
+
+    u32 exclusive_state = 0;
+
+    // WebAssembly backend additions
+    u32 halt = 0;  ///< HaltReason bits; generated code returns to the dispatcher when non-zero at CheckHalt
+    u32 ctx = 0;   ///< Jit::Impl* passed to host helper functions
+    alignas(8) u64 ticks_left = 0;
+    u64 cycles_to_run = 0;
+    u32 chain_depth = 0;  ///< nesting depth of chained block calls (non-tail chaining mode)
+
+    u32 Cpsr() const;
+    void SetCpsr(u32 cpsr);
+
+    u32 Fpscr() const;
+    void SetFpscr(u32 fpscr);
+
+    IR::LocationDescriptor GetLocationDescriptor() const {
+        return IR::LocationDescriptor{regs[15] | (static_cast<u64>(upper_location_descriptor) << 32)};
+    }
+};
+
+}  // namespace Dynarmic::Backend::Wasm
diff --git a/src/dynarmic/backend/wasm/emit_a32.cpp b/src/dynarmic/backend/wasm/emit_a32.cpp
new file mode 100644
index 0000000..4f33ca4
--- /dev/null
+++ b/src/dynarmic/backend/wasm/emit_a32.cpp
@@ -0,0 +1,1556 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * IR -> WebAssembly translation for the A32 frontend.
+ * Semantics of the IR opcodes follow Dynarmic's other backends; unsupported opcodes make the block fail
+ * with an error naming the opcode (the caller reports it).
+ */
+
+#include "dynarmic/backend/wasm/emit_a32.h"
+
+#include <cstddef>
+#include <cstring>
+#include <map>
+#include <cstdlib>
+#include <unordered_map>
+#include <unordered_set>
+
+#include <boost/variant.hpp>
+#include <mcl/bit/bit_field.hpp>
+
+#include "dynarmic/backend/wasm/a32_jitstate.h"
+#include "dynarmic/backend/wasm/wasm_builder.h"
+#include "dynarmic/frontend/A32/a32_location_descriptor.h"
+#include "dynarmic/frontend/A32/a32_types.h"
+#include "dynarmic/interface/A32/coprocessor.h"
+#include "dynarmic/interface/halt_reason.h"
+#include "dynarmic/ir/microinstruction.h"
+#include "dynarmic/ir/opcodes.h"
+#include "dynarmic/ir/terminal.h"
+
+namespace Dynarmic::Backend::Wasm {
+
+using IR::Opcode;
+
+namespace {
+
+constexpr u32 kOffNZCV = offsetof(A32JitState, cpsr_nzcv);
+constexpr u32 kOffQ = offsetof(A32JitState, cpsr_q);
+constexpr u32 kOffGE = offsetof(A32JitState, cpsr_ge);
+constexpr u32 kOffFpsrNZCV = offsetof(A32JitState, fpsr_nzcv);
+constexpr u32 kOffRegs = offsetof(A32JitState, regs);
+constexpr u32 kOffUpper = offsetof(A32JitState, upper_location_descriptor);
+constexpr u32 kOffExt = offsetof(A32JitState, ext_regs);
+constexpr u32 kOffHalt = offsetof(A32JitState, halt);
+constexpr u32 kOffCtx = offsetof(A32JitState, ctx);
+constexpr u32 kOffTicks = offsetof(A32JitState, ticks_left);
+constexpr u32 kOffDepth = offsetof(A32JitState, chain_depth);
+
+class Emitter {
+public:
+    Emitter(IR::Block& b, const A32::UserConfig& cfg, const EmitOptions& o) : block(b), conf(cfg), opt(o) {}
+
+    EmitResult Run() {
+        EmitResult res;
+        Generate();
+        if (error.empty()) res.bytes = Assemble();
+        res.error = error;
+        return res;
+    }
+
+private:
+    IR::Block& block;
+    const A32::UserConfig& conf;
+    const EmitOptions opt;
+    bool uses_table = false;
+    Code c;
+    std::vector<u8> extra_locals;  // types of locals after the single parameter (the state pointer)
+    std::unordered_map<const IR::Inst*, u32> local_of;
+    std::vector<std::string> import_order;
+    std::map<std::string, u32> import_index;
+    int check_bit_local = -1;
+    std::string error;  // first failure; emission stops once set
+
+    void Fail(const std::string& msg) { if (error.empty()) error = msg; }
+
+    // ---------- locals / values ----------
+    ValType WT(IR::Type t) {
+        if (t == IR::Type::U64) return I64;
+        if (t == IR::Type::U1 || t == IR::Type::U8 || t == IR::Type::U16 || t == IR::Type::U32 || t == IR::Type::NZCVFlags) return I32;
+        Fail("unsupported IR value type " + std::to_string(static_cast<int>(t)));
+        return I32;
+    }
+    // Scratch locals are recycled between IR instructions (a handler's temporaries are dead once it returns), which keeps big blocks
+    // from ending up with hundreds of locals. Locals that represent an IR value (Set / Alias) or are shared across instructions are
+    // never recycled.
+    std::vector<u32> free_locals[256];   // indexed by ValType byte
+    std::vector<u32> scratch_log;        // temporaries handed out while emitting the current instruction
+    std::unordered_set<u32> pinned;
+    u32 FreshLocal(ValType t) {
+        extra_locals.push_back(t);
+        return static_cast<u32>(extra_locals.size());  // +1 for the parameter, -1 for zero-based
+    }
+    u32 Tmp(ValType t) {
+        u32 l;
+        if (!recycle_off && !free_locals[t].empty()) { l = free_locals[t].back(); free_locals[t].pop_back(); }
+        else l = FreshLocal(t);
+        scratch_log.push_back(l);
+        return l;
+    }
+    void RecycleScratch() {
+        for (u32 l : scratch_log) if (!pinned.count(l)) free_locals[extra_locals[l - 1]].push_back(l);
+        scratch_log.clear();
+    }
+    const bool recycle_off = std::getenv("JIT_NORECYCLE") != nullptr;
+    // Pops the stack top into a fresh local that represents `inst`.
+    u32 Set(const IR::Inst* inst) {
+        const u32 l = FreshLocal(WT(inst->GetType()));
+        c.LocalSet(l);
+        local_of[inst] = l;
+        return l;
+    }
+    void Alias(const IR::Inst* inst, u32 local) { local_of[inst] = local; pinned.insert(local); }
+    void Ld(const IR::Value& v) {
+        if (v.IsImmediate()) {
+            switch (v.GetType()) {
+            case IR::Type::U1: c.I32Const(v.GetU1() ? 1 : 0); break;
+            case IR::Type::U8: c.I32Const(v.GetU8()); break;
+            case IR::Type::U16: c.I32Const(v.GetU16()); break;
+            case IR::Type::U32: c.I32Const(static_cast<s32>(v.GetU32())); break;
+            case IR::Type::U64: c.I64Const(static_cast<s64>(v.GetU64())); break;
+            default: Fail("unsupported immediate type"); c.I32Const(0); break;
+            }
+            return;
+        }
+        auto it = local_of.find(v.GetInst());
+        if (it == local_of.end()) {
+            Fail("value used before definition (producer opcode " + IR::GetNameOf(v.GetInst()->GetOpcode()) + ")");
+            c.I32Const(0);
+            return;
+        }
+        c.LocalGet(it->second);
+    }
+    void LdL(u32 local) { c.LocalGet(local); }
+
+    // ---------- helpers ----------
+    u32 Import(const char* name) {
+        auto it = import_index.find(name);
+        if (it != import_index.end()) return it->second;
+        const u32 idx = static_cast<u32>(import_order.size());
+        import_order.push_back(name);
+        import_index[name] = idx;
+        return idx;
+    }
+    void PushCtx() {
+        c.LocalGet(0);
+        c.I32Load(kOffCtx);
+    }
+    void CallHelper(const char* name) { c.Call(Import(name)); }
+
+    // ---------- state ----------
+    void StateLoad32(u32 off) {
+        c.LocalGet(0);
+        c.I32Load(off);
+    }
+    void SubTicks(u64 n) {
+        if (!conf.enable_cycle_counting || n == 0) return;
+        c.LocalGet(0);
+        c.LocalGet(0);
+        c.I64Load(kOffTicks);
+        c.I64Const(static_cast<s64>(n));
+        c.I64Sub();
+        c.I64Store(kOffTicks);
+    }
+
+    // Leaves 0/1 on the stack for condition `cond` evaluated on the current CPSR flags.
+    void EmitCond(IR::Cond cond) {
+        auto flag = [&](int bit) {  // 0/1
+            StateLoad32(kOffNZCV);
+            c.I32Const(bit);
+            c.I32ShrU();
+            c.I32Const(1);
+            c.I32And();
+        };
+        switch (cond) {
+        case IR::Cond::EQ: flag(30); break;
+        case IR::Cond::NE: flag(30); c.I32Eqz(); break;
+        case IR::Cond::CS: flag(29); break;
+        case IR::Cond::CC: flag(29); c.I32Eqz(); break;
+        case IR::Cond::MI: flag(31); break;
+        case IR::Cond::PL: flag(31); c.I32Eqz(); break;
+        case IR::Cond::VS: flag(28); break;
+        case IR::Cond::VC: flag(28); c.I32Eqz(); break;
+        case IR::Cond::HI: flag(29); flag(30); c.I32Eqz(); c.I32And(); break;
+        case IR::Cond::LS: flag(29); c.I32Eqz(); flag(30); c.I32Or(); break;
+        case IR::Cond::GE: flag(31); flag(28); c.I32Eq(); break;
+        case IR::Cond::LT: flag(31); flag(28); c.I32Ne(); break;
+        case IR::Cond::GT: flag(30); c.I32Eqz(); flag(31); flag(28); c.I32Eq(); c.I32And(); break;
+        case IR::Cond::LE: flag(30); flag(31); flag(28); c.I32Ne(); c.I32Or(); break;
+        case IR::Cond::AL:
+        case IR::Cond::NV: c.I32Const(1); break;
+        default: Fail("bad condition"); c.I32Const(1); break;
+        }
+    }
+
+    // ---------- terminals ----------
+    static u32 UpperOf(IR::LocationDescriptor d) {
+        return static_cast<u32>(A32::LocationDescriptor{d}.SetSingleStepping(false).UniqueHash() >> 32);
+    }
+    void SetUpper(IR::LocationDescriptor new_loc, IR::LocationDescriptor old_loc) {
+        const u32 nu = UpperOf(new_loc);
+        if (nu == UpperOf(old_loc)) return;
+        c.LocalGet(0);
+        c.I32Const(static_cast<s32>(nu));
+        c.I32Store(kOffUpper);
+    }
+    void Ret(int code) {
+        c.I32Const(code);
+        c.Return();
+    }
+    void EmitTerm(const IR::Terminal& t, IR::LocationDescriptor initial) {
+        if (auto* p = boost::get<IR::Term::LinkBlock>(&t)) { EmitLink(p->next, initial); }
+        else if (auto* p2 = boost::get<IR::Term::LinkBlockFast>(&t)) { EmitLink(p2->next, initial); }
+        else if (boost::get<IR::Term::ReturnToDispatch>(&t) || boost::get<IR::Term::PopRSBHint>(&t) || boost::get<IR::Term::FastDispatchHint>(&t)) { ChainDynamic(); Ret(0); }
+        else if (auto* i = boost::get<IR::Term::Interpret>(&t)) {
+            PushCtx();
+            c.I32Const(static_cast<s32>(A32::LocationDescriptor{i->next}.PC()));
+            c.I32Const(static_cast<s32>(i->num_instructions));
+            CallHelper("interp");
+            Ret(1);
+        } else if (auto* f = boost::get<IR::Term::If>(&t)) {
+            EmitCond(f->if_);
+            c.If();
+            EmitTerm(f->then_, initial);
+            c.Else();
+            EmitTerm(f->else_, initial);
+            c.End();
+        } else if (auto* cb = boost::get<IR::Term::CheckBit>(&t)) {
+            if (check_bit_local < 0) { Fail("CheckBit terminal without SetCheckBit"); return; }
+            c.LocalGet(static_cast<u32>(check_bit_local));
+            c.If();
+            EmitTerm(cb->then_, initial);
+            c.Else();
+            EmitTerm(cb->else_, initial);
+            c.End();
+        } else if (auto* ch = boost::get<IR::Term::CheckHalt>(&t)) {
+            StateLoad32(kOffHalt);
+            c.If();
+            Ret(1);
+            c.End();
+            EmitTerm(ch->else_, initial);
+        } else {
+            Fail("unsupported terminal");
+        }
+    }
+    void EmitLink(IR::LocationDescriptor next, IR::LocationDescriptor initial) {
+        SetUpper(next, initial);
+        c.LocalGet(0);
+        c.I32Const(static_cast<s32>(A32::LocationDescriptor{next}.PC()));
+        c.I32Store(kOffRegs + 4 * 15);
+        ChainStatic(A32::LocationDescriptor{next}.PC(), UpperOf(next));
+        Ret(0);
+    }
+
+    // ----- block chaining (tail calls through the shared function table) -----
+    // Leaves nothing on the stack; falls through when the chain cannot continue (cache miss, out of ticks, halt requested).
+    void EmitChainGuard() {  // pushes 1 if we may continue running guest code without returning to the host loop
+        c.LocalGet(0); c.I64Load(kOffTicks); c.I64Const(0); c.I64GtS();
+        StateLoad32(kOffHalt); c.I32Eqz();
+        c.I32And();
+    }
+    void EmitChainLookup(u32 entry_local, u32 pc_local, u32 up_local) {
+        // if (entry.pc == pc && entry.upper == upper) run table[entry.slot](state) next
+        c.LocalGet(entry_local); c.I32Load(0); c.LocalGet(pc_local); c.I32Eq();
+        c.LocalGet(entry_local); c.I32Load(4); c.LocalGet(up_local); c.I32Eq();
+        c.I32And();
+        if (opt.chain_tail) {
+            c.If();
+            c.LocalGet(0);
+            c.LocalGet(entry_local); c.I32Load(8);
+            c.ReturnCallIndirect(0, 0);
+            c.End();
+        } else {
+            // Nested call with a bounded depth: the callee chains further; when the limit is hit everything unwinds back to the host loop.
+            c.LocalGet(0); c.I32Load(kOffDepth); c.I32Const(static_cast<s32>(opt.chain_depth_limit)); c.I32LtU();
+            c.I32And();
+            c.If();
+            c.LocalGet(0); c.LocalGet(0); c.I32Load(kOffDepth); c.I32Const(1); c.I32Add(); c.I32Store(kOffDepth);
+            c.LocalGet(0);
+            c.LocalGet(entry_local); c.I32Load(8);
+            c.CallIndirect(0, 0);
+            c.LocalGet(0); c.LocalGet(0); c.I32Load(kOffDepth); c.I32Const(1); c.I32Sub(); c.I32Store(kOffDepth);
+            c.Return();
+            c.End();
+        }
+    }
+    void ChainStatic(u32 pc, u32 upper) {
+        if (!opt.chain) return;
+        uses_table = true;
+        const u32 idx = (pc >> 1) & opt.link_mask;
+        const u32 entry = Tmp(I32), pcl = Tmp(I32), upl = Tmp(I32);
+        EmitChainGuard();
+        c.If();
+        c.I32Const(static_cast<s32>(opt.link_base + idx * sizeof(LinkEntry))); c.LocalSet(entry);
+        c.I32Const(static_cast<s32>(pc)); c.LocalSet(pcl);
+        c.I32Const(static_cast<s32>(upper)); c.LocalSet(upl);
+        EmitChainLookup(entry, pcl, upl);
+        c.End();
+    }
+    void ChainDynamic() {
+        if (!opt.chain) return;
+        uses_table = true;
+        const u32 entry = Tmp(I32), pcl = Tmp(I32), upl = Tmp(I32);
+        EmitChainGuard();
+        c.If();
+        StateLoad32(kOffRegs + 4 * 15); c.LocalSet(pcl);
+        StateLoad32(kOffUpper); c.LocalSet(upl);
+        c.LocalGet(pcl); c.I32Const(1); c.I32ShrU(); c.I32Const(static_cast<s32>(opt.link_mask)); c.I32And();
+        c.I32Const(4); c.I32Shl(); c.I32Const(static_cast<s32>(opt.link_base)); c.I32Add(); c.LocalSet(entry);
+        EmitChainLookup(entry, pcl, upl);
+        c.End();
+    }
+
+    // ---------- main ----------
+    void Generate() {
+        const A32::LocationDescriptor location{block.Location()};
+        const IR::LocationDescriptor initial = location.SetSingleStepping(false);
+
+        if (block.GetCondition() != IR::Cond::AL) {
+            EmitCond(block.GetCondition());
+            c.I32Eqz();
+            c.If();
+            SubTicks(block.ConditionFailedCycleCount());
+            EmitTerm(IR::Term::LinkBlock{block.ConditionFailedLocation()}, initial);
+            c.End();
+        }
+        SubTicks(block.CycleCount());
+
+        for (auto& inst : block) {
+            EmitInst(&inst);
+            RecycleScratch();
+            if (!error.empty()) return;
+        }
+
+        EmitTerm(block.GetTerminal(), initial);
+        c.Unreachable();
+    }
+
+    IR::Inst* P(IR::Inst* inst, Opcode op) { return inst->GetAssociatedPseudoOperation(op); }
+    u32 Fpcr() const { return A32::LocationDescriptor{block.Location()}.FPSCR().Value(); }
+
+    // N and Z in bits 31 and 30 for the 32-bit value in `local`.
+    void EmitNZ(u32 local) {
+        c.LocalGet(local);
+        c.I32Const(static_cast<s32>(0x80000000u));
+        c.I32And();
+        c.LocalGet(local);
+        c.I32Eqz();
+        c.I32Const(30);
+        c.I32Shl();
+        c.I32Or();
+    }
+
+    void EmitNZpseudo(IR::Inst*, u32) {}  // GetNZFromOp is emitted by the pseudo-instruction itself (see EmitInst)
+
+    // ---------- shifts ----------
+    // Emits res into a new local and, if requested, the carry. `which`: 0 LSL, 1 LSR, 2 ASR, 3 ROR.
+    void EmitShift32(IR::Inst* inst, int which) {
+        auto* carry_inst = P(inst, Opcode::GetCarryFromOp);
+        const IR::Value v = inst->GetArg(0), amt = inst->GetArg(1), cin = inst->GetArg(2);
+        const u32 res = Tmp(I32);
+        u32 car = 0;
+        if (carry_inst) car = Tmp(I32);
+
+        if (amt.IsImmediate()) {
+            const u32 n = amt.GetU8();
+            if (n == 0) {
+                Ld(v); c.LocalSet(res);
+                if (carry_inst) { Ld(cin); c.LocalSet(car); }
+            } else if (which == 0) {  // LSL
+                if (n < 32) {
+                    Ld(v); c.I32Const(n); c.I32Shl(); c.LocalSet(res);
+                    if (carry_inst) { Ld(v); c.I32Const(32 - n); c.I32ShrU(); c.I32Const(1); c.I32And(); c.LocalSet(car); }
+                } else {
+                    c.I32Const(0); c.LocalSet(res);
+                    if (carry_inst) { if (n == 32) { Ld(v); c.I32Const(1); c.I32And(); } else { c.I32Const(0); } c.LocalSet(car); }
+                }
+            } else if (which == 1) {  // LSR
+                if (n < 32) {
+                    Ld(v); c.I32Const(n); c.I32ShrU(); c.LocalSet(res);
+                    if (carry_inst) { Ld(v); c.I32Const(n - 1); c.I32ShrU(); c.I32Const(1); c.I32And(); c.LocalSet(car); }
+                } else {
+                    c.I32Const(0); c.LocalSet(res);
+                    if (carry_inst) { if (n == 32) { Ld(v); c.I32Const(31); c.I32ShrU(); } else { c.I32Const(0); } c.LocalSet(car); }
+                }
+            } else if (which == 2) {  // ASR
+                const u32 m = n < 32 ? n : 31;
+                Ld(v); c.I32Const(m); c.I32ShrS(); c.LocalSet(res);
+                if (carry_inst) { Ld(v); c.I32Const(n < 32 ? n - 1 : 31); c.I32ShrS(); c.I32Const(1); c.I32And(); c.LocalSet(car); }
+            } else {  // ROR
+                Ld(v); c.I32Const(n & 31); c.I32Rotr(); c.LocalSet(res);
+                if (carry_inst) { c.LocalGet(res); c.I32Const(31); c.I32ShrU(); c.LocalSet(car); }
+            }
+        } else {
+            // amount known only at run time
+            if (which == 0) {
+                Ld(v); Ld(amt); c.I32Shl(); c.I32Const(0); Ld(amt); c.I32Const(32); c.I32LtU(); c.Select(); c.LocalSet(res);
+            } else if (which == 1) {
+                Ld(v); Ld(amt); c.I32ShrU(); c.I32Const(0); Ld(amt); c.I32Const(32); c.I32LtU(); c.Select(); c.LocalSet(res);
+            } else if (which == 2) {
+                Ld(v); Ld(amt); c.I32Const(31); Ld(amt); c.I32Const(32); c.I32LtU(); c.Select(); c.I32ShrS(); c.LocalSet(res);
+            } else {
+                Ld(v); Ld(amt); c.I32Rotr(); c.LocalSet(res);
+            }
+            if (carry_inst) {
+                Ld(amt); c.I32Eqz();
+                c.If(I32);
+                Ld(cin);
+                c.Else();
+                if (which == 0) {
+                    Ld(amt); c.I32Const(32); c.I32LeU();
+                    c.If(I32); Ld(v); c.I32Const(32); Ld(amt); c.I32Sub(); c.I32ShrU(); c.I32Const(1); c.I32And(); c.Else(); c.I32Const(0); c.End();
+                } else if (which == 1) {
+                    Ld(amt); c.I32Const(32); c.I32LeU();
+                    c.If(I32); Ld(v); Ld(amt); c.I32Const(1); c.I32Sub(); c.I32ShrU(); c.I32Const(1); c.I32And(); c.Else(); c.I32Const(0); c.End();
+                } else if (which == 2) {
+                    Ld(v); Ld(amt); c.I32Const(1); c.I32Sub(); c.I32Const(31); Ld(amt); c.I32Const(32); c.I32LtU(); c.Select(); c.I32ShrS(); c.I32Const(1); c.I32And();
+                } else {
+                    c.LocalGet(res); c.I32Const(31); c.I32ShrU();
+                }
+                c.End();
+                c.LocalSet(car);
+            }
+        }
+        Alias(inst, res);
+        if (carry_inst) Alias(carry_inst, car);
+        EmitNZpseudo(inst, res);
+    }
