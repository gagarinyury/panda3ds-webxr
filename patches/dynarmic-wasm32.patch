+    // ---------- packed SIMD operations (ARMv6) ----------
+    void EmitPackedAddSub8(IR::Inst* inst, bool sub, bool signed_ge) {
+        const u32 al = Tmp(I32); Ld(inst->GetArg(0)); c.LocalSet(al);
+        const u32 bl = Tmp(I32); Ld(inst->GetArg(1)); c.LocalSet(bl);
+
+        if (!sub) {
+            c.LocalGet(al); c.I32Const(0x7f7f7f7f); c.I32And();
+            c.LocalGet(bl); c.I32Const(0x7f7f7f7f); c.I32And();
+            c.I32Add();
+            c.LocalGet(al); c.LocalGet(bl); c.I32Xor();
+            c.I32Const(static_cast<s32>(0x80808080u)); c.I32And();
+            c.I32Xor();
+        } else {
+            c.LocalGet(al); c.I32Const(static_cast<s32>(0x80808080u)); c.I32Or();
+            c.LocalGet(bl); c.I32Const(0x7f7f7f7f); c.I32And();
+            c.I32Sub();
+            c.LocalGet(al); c.LocalGet(bl); c.I32Const(-1); c.I32Xor(); c.I32Xor();
+            c.I32Const(static_cast<s32>(0x80808080u)); c.I32And();
+            c.I32Xor();
+        }
+        const u32 res = Tmp(I32);
+        c.LocalSet(res);
+        Alias(inst, res);
+
+        if (auto* ge = P(inst, Opcode::GetGEFromOp)) {
+            if (!sub && !signed_ge) {
+                c.LocalGet(al); c.LocalGet(bl); c.I32And();
+                c.LocalGet(al); c.LocalGet(bl); c.I32Or();
+                c.LocalGet(res); c.I32Const(-1); c.I32Xor(); c.I32And();
+                c.I32Or();
+            } else if (!sub && signed_ge) {
+                c.LocalGet(al); c.I32Const(-1); c.I32Xor();
+                c.LocalGet(bl); c.I32Const(-1); c.I32Xor(); c.I32And();
+                c.LocalGet(al); c.LocalGet(bl); c.I32Xor();
+                c.LocalGet(res); c.I32Const(-1); c.I32Xor(); c.I32And();
+                c.I32Or();
+            } else if (sub && !signed_ge) {
+                const u32 not_b = Tmp(I32);
+                c.LocalGet(bl); c.I32Const(-1); c.I32Xor(); c.LocalSet(not_b);
+                c.LocalGet(al); c.LocalGet(not_b); c.I32And();
+                c.LocalGet(al); c.LocalGet(not_b); c.I32Or();
+                c.LocalGet(res); c.I32Const(-1); c.I32Xor(); c.I32And();
+                c.I32Or();
+            } else {
+                c.LocalGet(al); c.I32Const(-1); c.I32Xor(); c.LocalGet(bl); c.I32And();
+                c.LocalGet(al); c.LocalGet(bl); c.I32Xor(); c.I32Const(-1); c.I32Xor();
+                c.LocalGet(res); c.I32Const(-1); c.I32Xor(); c.I32And();
+                c.I32Or();
+            }
+            c.I32Const(static_cast<s32>(0x80808080u)); c.I32And();
+            const u32 gel = Tmp(I32);
+            c.LocalSet(gel);
+            c.LocalGet(gel); c.LocalGet(gel); c.I32Const(1); c.I32ShrU(); c.I32Or(); c.LocalSet(gel);
+            c.LocalGet(gel); c.LocalGet(gel); c.I32Const(2); c.I32ShrU(); c.I32Or(); c.LocalSet(gel);
+            c.LocalGet(gel); c.LocalGet(gel); c.I32Const(4); c.I32ShrU(); c.I32Or(); c.LocalSet(gel);
+            Alias(ge, gel);
+        }
+    }
