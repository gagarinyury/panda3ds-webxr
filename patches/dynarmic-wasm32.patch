new file mode 100644
index 0000000..f0cb5b3
--- /dev/null
+++ b/src/dynarmic/backend/wasm/wasm_builder.h
@@ -0,0 +1,128 @@
+/* This file is part of the panda3ds-wasm project.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Minimal WebAssembly binary writer (MVP + sign-extension ops).
+ */
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <mcl/stdint.hpp>
+
+namespace Dynarmic::Backend::Wasm {
+
+using Bytes = std::vector<u8>;
+
+inline void LebU(Bytes& b, u64 v) {
+    do {
+        u8 byte = v & 0x7f;
+        v >>= 7;
+        if (v) byte |= 0x80;
+        b.push_back(byte);
+    } while (v);
+}
+
+inline void LebS(Bytes& b, s64 v) {
+    for (;;) {
+        const u8 byte = v & 0x7f;
+        v >>= 7;
+        if ((v == 0 && !(byte & 0x40)) || (v == -1 && (byte & 0x40))) {
+            b.push_back(byte);
+            return;
+        }
+        b.push_back(byte | 0x80);
+    }
+}
+
+inline void Append(Bytes& b, const Bytes& o) { b.insert(b.end(), o.begin(), o.end()); }
+
+inline Bytes Section(u8 id, const Bytes& payload) {
+    Bytes b{id};
+    LebU(b, payload.size());
+    Append(b, payload);
+    return b;
+}
+
+inline Bytes Name(const char* s) {
+    Bytes b;
+    size_t n = 0;
+    while (s[n]) n++;
+    LebU(b, n);
+    for (size_t i = 0; i < n; i++) b.push_back(static_cast<u8>(s[i]));
+    return b;
+}
+
+enum ValType : u8 { I32 = 0x7f, I64 = 0x7e, F32 = 0x7d, F64 = 0x7c };
+
+// Function body writer. Numeric opcode names follow the spec text format.
+struct Code {
+    Bytes b;
+
+    void Op(u8 o) { b.push_back(o); }
+    void I32Const(s32 v) { Op(0x41); LebS(b, v); }
+    void I64Const(s64 v) { Op(0x42); LebS(b, v); }
+    void LocalGet(u32 i) { Op(0x20); LebU(b, i); }
+    void LocalSet(u32 i) { Op(0x21); LebU(b, i); }
+    void LocalTee(u32 i) { Op(0x22); LebU(b, i); }
+    void Call(u32 f) { Op(0x10); LebU(b, f); }
+    void CallIndirect(u32 type, u32 table) { Op(0x11); LebU(b, type); LebU(b, table); }
+    void ReturnCallIndirect(u32 type, u32 table) { Op(0x13); LebU(b, type); LebU(b, table); }
+
+    void I32Load(u32 off) { Op(0x28); Op(2); LebU(b, off); }
+    void I64Load(u32 off) { Op(0x29); Op(3); LebU(b, off); }
+    void I32Load8U(u32 off) { Op(0x2d); Op(0); LebU(b, off); }
+    void I32Load16U(u32 off) { Op(0x2f); Op(1); LebU(b, off); }
+    void I32Store8(u32 off) { Op(0x3a); Op(0); LebU(b, off); }
+    void I32Store16(u32 off) { Op(0x3b); Op(1); LebU(b, off); }
+    void I32Store(u32 off) { Op(0x36); Op(2); LebU(b, off); }
+    void I64Store(u32 off) { Op(0x37); Op(3); LebU(b, off); }
+
+    void Block(u8 blocktype = 0x40) { Op(0x02); Op(blocktype); }
+    void Br(u32 depth) { Op(0x0c); LebU(b, depth); }
+    void BrIf(u32 depth) { Op(0x0d); LebU(b, depth); }
+    void If(u8 blocktype = 0x40) { Op(0x04); Op(blocktype); }
+    void Else() { Op(0x05); }
+    void End() { Op(0x0b); }
+    void Return() { Op(0x0f); }
+    void Unreachable() { Op(0x00); }
+    void Drop() { Op(0x1a); }
+    void Select() { Op(0x1b); }
+
+    // i32
+    void I32Eqz() { Op(0x45); }  void I32Eq() { Op(0x46); }  void I32Ne() { Op(0x47); }
+    void I32LtS() { Op(0x48); }  void I32LtU() { Op(0x49); } void I32GtS() { Op(0x4a); } void I32GtU() { Op(0x4b); }
+    void I32LeS() { Op(0x4c); }  void I32LeU() { Op(0x4d); } void I32GeS() { Op(0x4e); } void I32GeU() { Op(0x4f); }
+    void I32Clz() { Op(0x67); }
+    void I32Add() { Op(0x6a); }  void I32Sub() { Op(0x6b); } void I32Mul() { Op(0x6c); }
+    void I32DivS() { Op(0x6d); } void I32DivU() { Op(0x6e); }
+    void I32And() { Op(0x71); }  void I32Or() { Op(0x72); }  void I32Xor() { Op(0x73); }
+    void I32Shl() { Op(0x74); }  void I32ShrS() { Op(0x75); } void I32ShrU() { Op(0x76); }
+    void I32Rotr() { Op(0x78); }
+    // i64
+    void I64GtS() { Op(0x55); }
+    void I64Eqz() { Op(0x50); }  void I64Eq() { Op(0x51); }  void I64Ne() { Op(0x52); }
+    void I64Add() { Op(0x7c); }  void I64Sub() { Op(0x7d); } void I64Mul() { Op(0x7e); }
+    void I64And() { Op(0x83); }  void I64Or() { Op(0x84); }  void I64Xor() { Op(0x85); }
+    void I64Shl() { Op(0x86); }  void I64ShrS() { Op(0x87); } void I64ShrU() { Op(0x88); }
+    // f32 / f64
+    void F32Eq() { Op(0x5b); } void F32Ne() { Op(0x5c); } void F32Lt() { Op(0x5d); } void F32Gt() { Op(0x5e); }
+    void F64Eq() { Op(0x61); } void F64Ne() { Op(0x62); } void F64Lt() { Op(0x63); } void F64Gt() { Op(0x64); }
+    void F32Abs() { Op(0x8b); } void F32Sqrt() { Op(0x91); } void F32Add() { Op(0x92); } void F32Sub() { Op(0x93); } void F32Mul() { Op(0x94); } void F32Div() { Op(0x95); }
+    void F64Abs() { Op(0x99); } void F64Sqrt() { Op(0x9f); } void F64Add() { Op(0xa0); } void F64Sub() { Op(0xa1); } void F64Mul() { Op(0xa2); } void F64Div() { Op(0xa3); }
+    void F64Promote0Ne() { Op(0x44); for (int i = 0; i < 8; i++) Op(0); Op(0x62); }  // f64 != 0.0
+    void F64LtZero() { Op(0x44); for (int i = 0; i < 8; i++) Op(0); Op(0x63); }      // f64 < 0.0
+    void F32DemoteF64() { Op(0xb6); } void F64PromoteF32() { Op(0xbb); }
+    void F32ConvertI32S() { Op(0xb2); } void F32ConvertI32U() { Op(0xb3); } void F64ConvertI32S() { Op(0xb7); } void F64ConvertI32U() { Op(0xb8); }
+    void I32ReinterpretF32() { Op(0xbc); } void F32ReinterpretI32() { Op(0xbe); }
+    void I64ReinterpretF64() { Op(0xbd); } void F64ReinterpretI64() { Op(0xbf); }
+    void I32TruncSatF32S() { Op(0xfc); Op(0x00); } void I32TruncSatF32U() { Op(0xfc); Op(0x01); }
+    void I32TruncSatF64S() { Op(0xfc); Op(0x02); } void I32TruncSatF64U() { Op(0xfc); Op(0x03); }
+    // conversions
+    void I32WrapI64() { Op(0xa7); }
+    void I64ExtendI32S() { Op(0xac); }
+    void I64ExtendI32U() { Op(0xad); }
+    void I32Extend8S() { Op(0xc0); }
+    void I32Extend16S() { Op(0xc1); }
+};
+
+}  // namespace Dynarmic::Backend::Wasm
