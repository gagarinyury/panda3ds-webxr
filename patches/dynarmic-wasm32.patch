+        case Opcode::SignExtendByteToWord: Ld(inst->GetArg(0)); c.I32Extend8S(); Set(inst); return;
+        case Opcode::SignExtendHalfToWord: Ld(inst->GetArg(0)); c.I32Extend16S(); Set(inst); return;
+        case Opcode::ZeroExtendByteToWord: case Opcode::ZeroExtendHalfToWord: Ld(inst->GetArg(0)); Set(inst); return;
+        case Opcode::SignExtendWordToLong: Ld(inst->GetArg(0)); c.I64ExtendI32S(); Set(inst); return;
+        case Opcode::ZeroExtendWordToLong: case Opcode::ZeroExtendByteToLong: case Opcode::ZeroExtendHalfToLong:
+            Ld(inst->GetArg(0)); c.I64ExtendI32U(); Set(inst); return;
+        case Opcode::CountLeadingZeros32: Ld(inst->GetArg(0)); c.I32Clz(); Set(inst); return;
+        case Opcode::ByteReverseWord: {
+            const u32 x = Tmp(I32);
+            Ld(inst->GetArg(0)); c.LocalSet(x);
+            c.LocalGet(x); c.I32Const(24); c.I32Shl();
+            c.LocalGet(x); c.I32Const(0xff00); c.I32And(); c.I32Const(8); c.I32Shl(); c.I32Or();
+            c.LocalGet(x); c.I32Const(8); c.I32ShrU(); c.I32Const(0xff00); c.I32And(); c.I32Or();
+            c.LocalGet(x); c.I32Const(24); c.I32ShrU(); c.I32Or();
+            Set(inst);
+            return;
+        }
+        case Opcode::ByteReverseHalf: {
+            const u32 x = Tmp(I32);
+            Ld(inst->GetArg(0)); c.LocalSet(x);
+            c.LocalGet(x); c.I32Const(0xff); c.I32And(); c.I32Const(8); c.I32Shl();
+            c.LocalGet(x); c.I32Const(8); c.I32ShrU(); c.I32Or();
+            Set(inst);
+            return;
+        }
+        case Opcode::ReplicateBit32:
+            c.I32Const(0); Ld(inst->GetArg(0)); Ld(inst->GetArg(1)); c.I32ShrU(); c.I32Const(1); c.I32And(); c.I32Sub(); Set(inst);
