+    // Inline page-table access (same tables Panda3DS uses): aligned, non-page-crossing accesses to mapped pages go straight to
+    // host memory; everything else (unaligned, MMIO / unmapped) calls the host helper.
+    void EmitFastRead(IR::Inst* inst, int size, const char* slow) {
+        const bool wide = size == 8;
+        if (!conf.wasm_read_table) {
+            PushCtx(); Ld(inst->GetArg(1)); CallHelper(slow);
+            if (size == 1) { c.I32Const(0xff); c.I32And(); }
+            if (size == 2) { c.I32Const(0xffff); c.I32And(); }
+            Set(inst);
+            return;
+        }
+        const u32 v = Tmp(I32), pte = Tmp(I32);
+        Ld(inst->GetArg(1)); c.LocalSet(v);
+        c.Block(wide ? I64 : I32);   // $done
+        c.Block();                   // $slow
+        if (size > 1) { c.LocalGet(v); c.I32Const(size == 2 ? 1 : 3); c.I32And(); c.BrIf(0); }
+        if (wide) { c.LocalGet(v); c.I32Const(0xfff); c.I32And(); c.I32Const(0xff8); c.I32GtU(); c.BrIf(0); }
+        c.I32Const(static_cast<s32>(reinterpret_cast<uintptr_t>(conf.wasm_read_table)));
+        c.LocalGet(v); c.I32Const(12); c.I32ShrU(); c.I32Const(2); c.I32Shl(); c.I32Add(); c.I32Load(0);
+        c.LocalTee(pte); c.I32Eqz(); c.BrIf(0);
+        c.LocalGet(pte); c.LocalGet(v); c.I32Const(0xfff); c.I32And(); c.I32Add();
+        if (size == 1) c.I32Load8U(0); else if (size == 2) c.I32Load16U(0); else if (size == 4) c.I32Load(0); else c.I64Load(0);
+        c.Br(1);
+        c.End();                     // $slow
+        PushCtx(); c.LocalGet(v); CallHelper(slow);
+        if (size == 1) { c.I32Const(0xff); c.I32And(); }
+        if (size == 2) { c.I32Const(0xffff); c.I32And(); }
+        c.End();                     // $done
+        Set(inst);
+    }
+    void EmitFastWrite(IR::Inst* inst, int size, const char* slow) {
+        const bool wide = size == 8;
+        if (!conf.wasm_write_table) {
+            PushCtx(); Ld(inst->GetArg(1)); Ld(inst->GetArg(2)); CallHelper(slow);
+            return;
+        }
+        const u32 v = Tmp(I32), pte = Tmp(I32), val = Tmp(wide ? I64 : I32);
+        Ld(inst->GetArg(1)); c.LocalSet(v);
+        Ld(inst->GetArg(2)); c.LocalSet(val);
+        c.Block();                   // $done
+        c.Block();                   // $slow
+        if (size > 1) { c.LocalGet(v); c.I32Const(size == 2 ? 1 : 3); c.I32And(); c.BrIf(0); }
+        if (wide) { c.LocalGet(v); c.I32Const(0xfff); c.I32And(); c.I32Const(0xff8); c.I32GtU(); c.BrIf(0); }
+        c.I32Const(static_cast<s32>(reinterpret_cast<uintptr_t>(conf.wasm_write_table)));
+        c.LocalGet(v); c.I32Const(12); c.I32ShrU(); c.I32Const(2); c.I32Shl(); c.I32Add(); c.I32Load(0);
+        c.LocalTee(pte); c.I32Eqz(); c.BrIf(0);
+        c.LocalGet(pte); c.LocalGet(v); c.I32Const(0xfff); c.I32And(); c.I32Add();
+        c.LocalGet(val);
+        if (size == 1) c.I32Store8(0); else if (size == 2) c.I32Store16(0); else if (size == 4) c.I32Store(0); else c.I64Store(0);
+        c.Br(1);
+        c.End();                     // $slow
+        PushCtx(); c.LocalGet(v); c.LocalGet(val); CallHelper(slow);
+        c.End();                     // $done
+    }
